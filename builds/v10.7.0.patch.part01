r-radius:8px;overflow:hidden;background:#0a0f18;border:1px solid #38455c}.p66ArchiveHero figure img{width:100%;height:100%;object-fit:contain}.p66ArchiveHero b{display:block;font-size:5.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.p66ArchiveHero small{display:block;font-size:4.2px;color:#7f8ca0;margin-top:2px}.p66ArchiveHero strong{font-size:6px;color:#d8b66f}\n@media(max-width:900px){\n .p66AscHub{grid-template-columns:110px minmax(0,1fr)}.p66AscRail{padding:6px 5px;gap:4px}.p66AscRailHead{padding:3px 4px 5px}.p66AscRailHead b{font-size:8px}.p66AscTab{grid-template-columns:21px 1fr;padding:5px 4px;gap:4px;border-radius:8px}.p66AscTab i{width:21px;height:21px;border-radius:7px;font-size:10px}.p66AscTab span b{font-size:5px}.p66AscTab span small{font-size:3.7px}.p66AscRailResources span{padding:3px 4px;font-size:3.8px}.p66AscRailResources b{font-size:4px}\n .p66AscHero{height:38px;flex-basis:38px;padding:4px 7px}.p66AscHero small{font-size:3.7px}.p66AscHero h3{font-size:8px}.p66AscHero p{display:none}.p66AscHero strong{font-size:14px}.p66AscBody{padding:5px}.p66RebirthLayout{grid-template-columns:minmax(0,1.45fr) 155px;gap:4px}.p66RebirthRoad{padding:5px;border-radius:9px}.p66RebirthNodes{gap:4px}.p66RebirthNode{border-radius:8px}.p66RebirthNode em{font-size:12px}.p66RebirthNode b{font-size:4.5px}.p66RebirthNode small{font-size:3px}.p66RebirthSide{padding:5px;border-radius:9px}.p66NextKicker{font-size:3.5px}.p66RebirthSide h4{font-size:7px;margin:2px 0}.p66RebirthSide>p{font-size:3.6px;margin-bottom:4px}.p66CostLine span{font-size:3.5px;padding:2px 3px}.p66ReqMini{gap:2px;margin-bottom:4px}.p66ReqMini span{font-size:3.2px;padding:2px 3px}.p66AscAction{padding:5px;font-size:3.7px}.p66Source{font-size:3.2px;padding:3px}\n .p66ConstLayout{gap:4px}.p66ConstPath{padding:5px;border-radius:9px}.p66ConstPath:before{top:35px;bottom:34px}.p66ConstPathHead{gap:3px}.p66ConstPathHead>i{width:20px;height:20px;font-size:9px}.p66ConstPathHead b{font-size:4.5px}.p66