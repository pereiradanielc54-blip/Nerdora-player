der:1px solid #9a6b29;background:linear-gradient(180deg,#8a5b20,#4a3016);color:#ffebbf;font-weight:1000;font-size:6px;letter-spacing:.06em}.p66AscAction:disabled{opacity:.33;filter:grayscale(.4)}.p66Source{margin-top:6px;padding:5px 6px;border-top:1px solid #29354a;color:#6f7e94;font-size:5px}\n.p66ConstLayout{height:100%;display:grid;grid-template-columns:repeat(3,1fr);gap:8px;min-height:0}.p66ConstPath{position:relative;min-height:0;border:1px solid color-mix(in srgb,var(--pc) 50%,#29364b);border-radius:14px;background:radial-gradient(circle at 50% 28%,color-mix(in srgb,var(--pc) 14%,transparent),transparent 44%),linear-gradient(180deg,#111827,#090e18);padding:8px;display:flex;flex-direction:column;overflow:hidden}.p66ConstPath:before{content:\"\";position:absolute;left:50%;top:54px;bottom:48px;width:1px;background:linear-gradient(var(--pc),rgba(255,255,255,.05));opacity:.5}.p66ConstPathHead{display:flex;align-items:center;gap:6px;position:relative;z-index:1}.p66ConstPathHead>i{font-style:normal;width:27px;height:27px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--pc);color:var(--pc);box-shadow:0 0 15px color-mix(in srgb,var(--pc) 20%,transparent)}.p66ConstPathHead div{min-width:0}.p66ConstPathHead b{display:block;font-size:7px;color:#e8edf5}.p66ConstPathHead small{display:block;font-size:4.5px;color:#7e8ba0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.p66ConstPathHead strong{margin-left:auto;color:var(--pc);font-size:9px}.p66ConstStars{flex:1;min-height:0;margin-top:5px;display:grid;grid-template-rows:repeat(4,1fr);gap:3px;position:relative;z-index:1}.p66ConstStar{display:grid;grid-template-columns:24px 1fr;gap:5px;align-items:center;padding:3px 5px;border-radius:9px;border:1px solid #29354a;background:#0b121f;min-height:0}.p66ConstStar>span{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;border:1px solid #3d4a60;color:#5f6e84;background:#0e1624;font-size:10px}.p66ConstStar b{display:block;font-size:5.5px;color:#9da9bb}.p66ConstStar small{display:block;font-size:4.2px;color:#68768b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.p66ConstStar.done{border-color:color-mix(in srgb,var(--pc) 45%,#2c3b4f)}.p66ConstStar.done>span{border-color:var(--pc);color:var(--pc);box-shadow:0 0 11px color-mix(in srgb,var(--pc) 25%,transparent)}.p66ConstStar.next{border-color:var(--pc);background:color-mix(in srgb,var(--pc) 8%,#0b121f)}.p66ConstAction{position:relative;z-index:1;margin-top:5px}.p66ConstAction small{display:block;font-size:4.3px;color:#79869c;margin-bottom:4px}.p66ConstAction button{width:100%;padding:6px;border-radius:8px;border:1px solid color-mix(in srgb,var(--pc) 65%,#6b6b6b);background:color-mix(in srgb,var(--pc) 24%,#162034);color:#fff;font-size:5px;font-weight:900}.p66ConstAction button:disabled{opacity:.3}\n.p66DivLayout{height:100%;display:grid;grid-template-columns:minmax(0,1fr) 230px;gap:8px;min-height:0}.p66DivAltar{min-height:0;border:1px solid #413b55;border-radius:14px;background:radial-gradient(circle at 50% 15%,rgba(249,204,112,.16),transparent 31%),radial-gradient(circle at 50% 100%,rgba(122,74,164,.13),transparent 42%),#0b101b;display:flex;flex-direction:column;padding:9px;overflow:hidden}.p66DivRanks{flex:1;min-height:0;display:grid;grid-template-columns:repeat(5,1fr);gap:6px;align-items:end}.p66DivRank{height:76%;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:3px;position:relative;padding:7px 3px;border:1px solid #30394b;border-radius:12px 12px 6px 6px;background:linear-gradient(180deg,#151827,#0c111b);opacity:.6}.p66DivRank:nth-child(2){height:81%}.p66DivRank:nth-child(3){height:86%}.p66DivRank:nth-child(4){height:92%}.p66DivRank:nth-child(5){height:100%}.p66DivRank>i{font-style:normal;font-size:20px;filter:grayscale(.6)}.p66DivRank b{font-size:5.3px;color:#a3adbd;text-align:center}.p66DivRank small{font-size:4px;color:#6e788b}.p66DivRank.done{opacity:1;border-color:#b88942;background:linear-gradient(180deg,#3b2b16,#17120b);box-shadow:0 0 17px rgba(221,167,73,.12)}.p66DivRank.done>i{filter:none}.p66DivRank.next{opacity:1;border-color:#986ecb;box-shadow:0 0 17px rgba(151,106,205,.14)}.p66Seals{display:flex;gap:2px}.p66Seals span{font-size:7px;color:#566278}.p66Seals span.on{color:#ffd473;text-shadow:0 0 7px #ffc84a}.p66DivSide{display:flex;flex-direction:column;padding:9px;border:1px solid #3d4558;border-radius:14px;background:linear-gradient(180deg,#17182a,#0b101b);overflow:auto}.p66DivSide h4{margin:3px 0 4px;color:#ffe19d;font-size:11px}.p66DivSide p{margin:0 0 6px;color:#8996aa;font-size:5.5px;line-height:1.4}.p66Bless{padding:7px;border:1px solid #62517a;border-radius:9px;background:linear-gradient(135deg,#241a35,#13182a);margin-bottom:6px}.p66Bless b{display:block;font-size:6px;color:#cdb5ef}.p66Bless small{display:block;margin-top:2px;font-size:4.5px;color:#8f9ab0}\n/* Crônicas: livro fixo */\n.p66ChronBook{display:grid;grid-template-columns:210px minmax(0,1fr);background:linear-gradient(90deg,#171013 0 24%,#0f1420 24% 100%)}.p66BookCover{min-height:0;padding:10px;border-right:1px solid #493836;background:radial-gradient(circle at 50% 25%,rgba(209,163,87,.16),transparent 30%),linear-gradient(155deg,#2d1b18,#170f12 58%,#0b0d13);display:flex;flex-direction:column;align-items:center;text-align:center;overflow:hidden}.p66BookSigil{width:58px;height:58px;border-radius:50%;display:grid;place-items:center;border:1px solid #c4934e;background:radial-gradient(circle,#684119,#23160e 65%);box-shadow:0 0 25px rgba(226,174,86,.15);font-size:27px;margin-top:2px}.p66BookCover small{font-size:5px;letter-spacing:.15em;color:#a78456;margin-top:7px}.p66BookCover h3{margin:4px 0;color:#ffe2a5;font-size:12px}.p66BookCover p{margin:0;color:#ae9d91;font-size:5.3px;line-height:1.5}.p66BookProgress{width:100%;margin-top:8px}.p66BookProgress div{height:5px;border-radius:999px;background:#1b1718;border:1px solid #4a3430;overflow:hidden}.p66BookProgress i{display:block;height:100%;background:linear-gradient(90deg,#765023,#e4b969);box-shadow:0 0 10px #dcae5b}.p66BookProgress span{display:flex;justify-content:space-between;margin-top:3px;font-size:4.5px;color:#8d7868}.p66BookBonus{margin-top:auto;width:100%;padding:7px 5px;border-top:1px solid #4a3531;color:#a89582;font-size:4.7px}.p66BookBonus b{color:#f0ca82}.p66BookPages{min-width:0;min-height:0;display:flex;flex-direction:column;padding:8px 9px;background:linear-gradient(90deg,rgba(218,196,155,.025),transparent 3%,transparent 97%,rgba(218,196,155,.025));}.p66PageHead{height:35px;flex:0 0 35px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #303848;padding:0 3px 6px}.p66PageHead div small{display:block;font-size:5px;color:#7e8ca1;letter-spacing:.1em}.p66PageHead div b{font-size:8px;color:#e9d9bd}.p66PageHead strong{font-size:10px;color:#e7bd72}.p66BookChapters{min-height:0;flex:1;overflow-y:auto;overscroll-behavior:contain;padding:6px 2px 2px;display:grid;grid-template-columns:1fr 1fr;gap:6px}.p66Chapter{display:grid;grid-template-columns:31px 1fr;gap:6px;align-items:start;padding:7px;border:1px solid #303a4d;border-radius:11px;background:linear-gradient(180deg,#111a29,#0a101b);opacity:.52;min-height:78px}.p66Chapter.done{opacity:1;border-color:#466d59;background:linear-gradient(180deg,#13271f,#0b1814)}.p66Chapter.ready{opacity:1;border-color:#9a7541;background:linear-gradient(180deg,#2b2013,#15110d)}.p66ChapterIcon{width:29px;height:29px;border-radius:9px;display:grid;place-items:center;background:#171f2e;border:1px solid #3a4558;font-size:16px}.p66Chapter.done .p66ChapterIcon{border-color:#4f896c;color:#82d8ac}.p66Chapter.ready .p66ChapterIcon{border-color:#b98a44}.p66ChapterCopy b{display:block;font-size:6.5px;color:#d9e0eb}.p66ChapterCopy small{display:block;font-size:4.2px;color:#727f94}.p66ChapterCopy p{margin:3px 0;font-size:4.5px;line-height:1.35;color:#8794a8}.p66ChapterState{font-size:4.5px;color:#9aa5b6}.p66ChapterReward{grid-column:1/-1;dis