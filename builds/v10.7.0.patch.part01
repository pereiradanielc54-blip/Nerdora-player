efore{position:absolute;top:-7px;font-size:5px;letter-spacing:.15em;color:#8491a5}.p68Battle .battleSide.player:before{content:\"ESQUADRÃO NERDORA\";left:4px}.p68Battle .battleSide.enemy:before{content:\"FORÇA INIMIGA\";right:4px}.p68Battle .battleLine{border-color:#ffffff08;background:linear-gradient(180deg,transparent,#ffffff03,transparent)}\n.p68BattleHud{position:absolute;left:50%;top:5px;transform:translateX(-50%);z-index:45;width:min(300px,36vw);height:35px;display:grid;grid-template-columns:70px 1fr 70px;align-items:center;border:1px solid #564832;border-radius:11px;background:#080c14e8;box-shadow:0 5px 18px #0009;backdrop-filter:blur(7px);pointer-events:none}.p68BattleHud>div{text-align:center}.p68BattleHud small,.p68BattleHud b,.p68BattleHud span{display:block}.p68BattleHud small{font-size:3.7px;color:#8390a4}.p68BattleHud b{font-size:7px;color:#f0d495}.p68BattleHud span{font-size:3.8px;color:#79879c}.p68BattleHud .p68Team.p b{color:#76c6ff}.p68BattleHud .p68Team.e b{color:#ff8e9a}.p68Round{border-left:1px solid #373d4d;border-right:1px solid #373d4d}\n.p68Unit{width:clamp(116px,17vw,165px)!important;min-height:0!important;padding:5px!important;display:grid;grid-template-columns:40px minmax(0,1fr);gap:5px;border-radius:11px!important;transform:translateY(-50%);background:linear-gradient(160deg,#152239f2,#0b111df5)!important;border:1px solid #426487!important;box-shadow:0 7px 15px #0008,inset 0 1px #ffffff0a;transition:transform .18s,filter .18s,opacity .18s,box-shadow .18s!important}.p68Unit.enemy{background:linear-gradient(160deg,#372028f2,#180f16f5)!important;border-color:#794552!important}.p68Unit.active{outline:0!important;transform:translateY(-50%) scale(1.035)!important;box-shadow:0 0 0 1px #e8bf69,0 0 18px #e8bf6944,0 8px 17px #0009!important;z-index:20}.p68Portrait{position:relative;width:40px;height:46px;display:grid;place-items:center;overflow:hidden;border:1px solid #4b5a74;border-radius:9px;background:radial-gradient(circle,#30405b,#0d1420);font-size:24px}.p68Unit.enemy .p68Portrait{border-color:#754651;background:radial-gradient(circle,#56313a,#1a1117)}.p68Portrait img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 3px 3px #0008)}.p68Portrait em{position:absolute;right:1px;bottom:1px;padding:1px 3px;border-radius:4px;background:#060a11dd;color:#c4cedc;font-size:4px;font-style:normal}.p68UnitTop{display:flex;justify-content:space-between;gap:3px;align-items:center}.p68UnitTop b{max-width:68%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:5.7px;color:#edf3fb}.p68UnitTop span{font-size:3.6px;color:#7e8ca1;white-space:nowrap}.p68BarRow{display:grid;grid-template-columns:21px 1fr 29px;gap:3px;align-items:center;margin-top:3px}.p68BarRow small{font-size:3.5px;color:#8290a3}.p68BarRow strong{text-align:right;font-size:3.8px;color:#aeb9c8}.p68Bar{height:5px;border-radius:99px;background:#070b12;border:1px solid #29364b;overflow:hidden}.p68Bar i{display:block;height:100%;background:linear-gradient(90deg,#b52e42,#ee5d6e);transition:width .18s}.p68BarRow.rage .p68Bar i{background:linear-gradient(90deg,#245ca2,#56b8ff)}.p68Unit.lowhp .p68Bar.hp i{animation:p68low 1s ease-in-out infinite}.p68Status{height:10px;display:flex;gap:2px;align-items:center;overflow:hidden}.p68Status i{font-size:7px;font-style:normal}.p68Ult{width:100%;height:16px;margin-top:1px;border:1px solid #34465e;border-radius:5px;background:#111a28;color:#69788e;font-size:3.7px;font-weight:1000}.p68Ult.ready{border-color:#c09645;background:linear-gradient(135deg,#725018,#b88326);color:#fff1c5;box-shadow:0 0 11px #e4b75f44;animation:p68ready 1.1s ease-in-out infinite}.p68Ult.queued{border-color:#caa959;background:linear-gradient(135deg,#4e3720,#785526);color:#ffe7a2}\n.p68Battle .battleOrder{left:50%;top:45px;transform:translateX(-50%);max-width:35%;height:30px;gap:2px;padding:3px;border-radius:8px;background:#070b12d8;border-color:#2f394d;overflow:hidden;z-index:42}.p68Battle .orderChip{width:26px;height:22px;displ