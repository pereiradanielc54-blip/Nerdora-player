pan><span><b>${Object.keys(P542_EMBLEM_SETS).length}</b><small>conjuntos</small></span></div><div class=\"p65HeroActions\"><button onclick=\"Game.p65HeroPicker('meta','Emblemas · escolher herói')\">GERENCIAR HERÓI</button><button onclick=\"Game.openForge()\">⚒ FORJA</button></div></header><div class=\"p65RuneWorkspace\"><aside class=\"p65SetRail\">${Object.entries(P542_EMBLEM_SETS).map(([k,d])=>{const count=items.filter(x=>x.set===k).reduce((n,x)=>n+(state.phase542.emblemInventory[x.id]||0),0);return `<article style=\"--set:${d.color}\"><span>${d.icon}</span><div><b>${d.name}</b><small>Build especializada</small><p>2/4 peças · ${count} no inventário</p></div></article>`}).join('')}</aside><main class=\"p65RuneGrid emblems ui61InnerScroll\">${items.length?items.map(d=>`<article style=\"--piece:${P542_EMBLEM_SETS[d.set].color}\"><span>${d.icon}</span><div><small>${d.rarity} · ${P542_EMBLEM_SLOT_NAMES[d.slot]}</small><b>${d.name}</b><p>${p542StatText(p542EmblemStats({id:d.id,level:0}))}</p></div><strong>x${state.phase542.emblemInventory[d.id]||0}</strong></article>`).join(''):'<div class=\"p65Empty\">Nenhum emblema solto. Use a Forja ou obtenha recompensas avançadas.</div>'}</main></div></section>`}\n\nfunction p65ArtifactCard(a){const lv=state.artifacts.levels[a.id]||0,asc=state.phase59.artifactAscension[a.id]||0,active=state.artifacts.active===a.id,set=P59_ART_SETS[a.set];return `<article class=\"p65LegacyCard ${active?'active':''}\" style=\"--legacy:${active?'#f1ca78':'#8d6dcc'}\"><div class=\"p65LegacyIcon\">${a.icon}</div><div class=\"p65LegacyCopy\"><small>${a.rarity||'SR'} · ${set?.name||'Legado'}</small><b>${p65Esc(a.name)}</b><p>${p65Esc(a.desc)}</p><span>NV.${lv}/${a.max} · ${'◆'.repeat(asc)}${'◇'.repeat(5-asc)}</span></div><div class=\"p65LegacyActions\"><button onclick=\"Game.activateArtifact('${a.id}')\">${active?'ATIVO':'ATIVAR'}</button><button onclick=\"Game.levelArtifact('${a.id}')\" ${lv>=a.max?'disabled':''}>↑ NÍVEL</button><button class=\"gold\" onclick=\"Game.ascendArtifact('${a.id}')\" ${lv<a.max||asc>=5?'disabled':''}>☀ ASCENDER</button></div></article>`}\nfunction p65ArtifactPane(){p59Ensure();return `<section class=\"p65Pane\"><header class=\"p65PaneHero artifact\"><div><small>SANTUÁRIO DE LEGADOS</small><h2>Artefatos</h2><p>Um Artefato ativo define uma assinatura de combate. Ressonâncias fortalecem toda a coleção.</p></div><div class=\"p65PaneStats\"><span><b>${fmt(state.resources.artifact_core||0)}</b><small>núcleos</small></span><span><b>${fmt(state.resources.divinity_essence||0)}</b><small>essência divina</small></span><span><b>${D.phase4.artifacts.length}</b><small>artefatos</small></span></div></header><div class=\"p65LegacyWorkspace\"><aside class=\"p65Resonance\">${Object.entries(P59_ART_SETS).map(([id,set])=>{const tier=p59ArtTier(id);return `<article class=\"${tier?'on':''}\"><span>${set.icon}</span><div><b>${set.name}</b><small>${set.copy}</small></div><strong>Tier ${tier}/3</strong></article>`}).join('')}</aside><main class=\"p65LegacyGrid ui61InnerScroll\">${D.phase4.artifacts.map(p65ArtifactCard).join('')}</main></div></section>`}\n\nfunction p65RelicCard(r){const lv=state.relics.levels[r.id]||0,st=state.phase59.relicStars[r.id]||0,req=(st+1)*4,set=P59_RELIC_SETS[r.set];return `<article class=\"p65LegacyCard relic\" style=\"--legacy:#6bc7cb\"><div class=\"p65LegacyIcon\">${r.icon}</div><div class=\"p65LegacyCopy\"><small>${set?.name||'Relíquia Ancestral'}</small><b>${p65Esc(r.name)}</b><p>${p65Esc(r.desc)}</p><span>NV.${lv}/${r.max} · ${'★'.repeat(st)}${'☆'.repeat(5-st)}</span></div><div class=\"p65LegacyActions\"><button onclick=\"Game.levelRelic('${r.id}')\" ${lv>=r.max?'disabled':''}>↑ MELHORAR</button><button class=\"gold\" onclick=\"Game.starRelic('${r.id}')\" ${st>=5||lv<req?'disabled':''}>★ ELEVAR</button></div></article>`}\nfunction p65RelicPane(){p59Ensure();const d=state.phase59.relicDungeon;return `<section class=\"p65Pane\"><header class=\"p65PaneHero relic\"><div><small>COFRE ANCESTRAL</small><h2>Relíquias</h2><p>Oito relíquias, cinco estrelas e quatro conjuntos permanentes para toda a conta.</p></div><div class=\"p65PaneStats\"><span><b>${fmt(state.resources.relic_dust||0)}</b><small>pó</small></span><span><b>${fmt(state.resources.relic_crystal||0)}</b><small>cristais</small></span><span><b>${d.best||0}</b><small>melhor andar</small></span></div><div class=\"p65HeroActions\"><button onclick=\"Game.startRelicDungeon()\" ${d.tries<=0?'disabled':''}>⚔ COFRE ${d.floor}</button><button onclick=\"UI.nav('formation')\">FORMAÇÃO</button></div></header><div class=\"p65LegacyWorkspace\"><aside class=\"p65Resonance\">${Object.entries(P59_RELIC_SETS).map(([id,set])=>{const tier=p59RelicSetTier(id);return `<article class=\"${tier?'on':''}\"><span>${set.icon}</span><div><b>${set.name}</b><small>${set.copy}</small></div><strong>Tier ${tier}/4</strong></article>`}).join('')}<div class=\"p65DungeonMini\"><b>Cofre Ancestral · Andar ${d.floor}</b><small>${d.tries}/3 tentativas · Chefes a cada 5 andares</small></div></aside><main class=\"p65LegacyGrid ui61InnerScroll\">${D.phase4.relics.map(p65RelicCard).join('')}</main></div></section>`}\n\nrenderInventory=function(){p542Ensure();p59Ensure();const tab=UI.p65InvTab||'equipment';const pane=tab==='equipment'?p65EquipmentPane():tab==='materials'?p65MaterialsPane():tab==='runes'?p65RunePane():tab==='emblems'?p65EmblemPane():tab==='artifacts'?p65ArtifactPane():p65RelicPane();$('#screen').innerHTML=`${title('Arsenal & Legados','Equipamentos, Runas, Emblemas, Artefatos e Relíquias em um único espaço.') }<div class=\"p65Shell\">${p65Nav()}<div class=\"p65Content\">${pane}</div></div>`};\n\n// Hero build panels share the same premium visual language.\nheroGear=function(id){const h=heroState(id),equipped=D.equipment.slots.filter(s=>h.equipment?.[s]).length,rec=p541RecommendedSet(id),counts=p541SetCounts(id);return `<div class=\"p65HeroSystem gear\">${p542BuildBar(id)}<header><div><small>BUILD DO HERÓI</small><h3>Equipamentos</h3><p>${equipped}/6 slots · recomendado: <b>${rec}</b></p></div><div><strong>⚔ ${fmt(heroPower(id))}</strong><button onclick=\"Game.autoEquip('${id}')\">AUTO EQUIP</button><button class=\"gold\" onclick=\"Game.enhanceAllGear('${id}')\">MELHORAR TUDO</button><button onclick=\"UI.nav('inventory');UI.p65InvTab='equipment';UI.closeModal()\">ARSENAL</button></div></header><div class=\"p65HeroSystemBody ui61InnerScroll\"><div class=\"p65GearGrid\">${D.equipment.slots.map(slot=>p541GearCard(id,slot,h.equipment[slot])).join('')}</div><div class=\"p65ActiveSetStrip\">${Object.entries(P541_SETS).map(([n,d])=>{const c=counts[n]||0;return `<span class=\"${c>=2?'on':''}\" style=\"--set:${d.color}\">${d.icon} <b>${n}</b> ${c}/6</span>`}).join('')}</div></div></div>`};\nheroRunes=function(id){const h=heroState(id),counts=p542SetCounts(h.runeGear,p542DefRune);return `<div class=\"p65HeroSystem runes\">${p542BuildBar(id)}<header><div><small>GRIMÓRIO DO HERÓI</small><h3>Runas</h3><p>5 slots · bônus 2/4/5 · níveis independentes.</p></div><div><strong>◇ ${fmt(state.resources.rune_stone||0)}</strong><button onclick=\"Game.openRuneInventory('${id}')\">INVENTÁRIO</button><button class=\"gold\" onclick=\"Game.openForge()\">FORJA</button></div></header><div class=\"p65HeroSystemBody ui61InnerScroll\"><div class=\"p65BuildSetSummary\">${p542SetText(counts,P542_RUNE_SETS)}</div><div class=\"p65PieceGrid\">${(h.runeGear||[]).map((p,i)=>p542RuneCard(id,i,p)).join('')}</div></div></div>`};\nheroMeta=function(id){const h=heroState(id),counts=p542SetCounts(h.emblemPieces,p542DefEmblem);return `<div class=\"p65HeroSystem emblems\">${p542BuildBar(id)}<header><div><small>HERÁLDICA DO HERÓI</small><h3>Emblemas</h3><p>4 peças · bônus 2/4 · especialização independente.</p></div><div><strong>♜ ${fmt(state.resources.emblem_shard||0)}</strong><button onclick=\"Game.openEmblemInventory('${id}')\">INVENTÁRIO</button><button class=\"gold\" onclick=\"Game.openForge()\">FORJA</button></div></header><div class=\"p65HeroSystemBody ui61InnerScroll\"><div class=\"p65BuildSetSummary\">${p542SetText(counts,P542_EMBLEM_SETS)}</div><div class=\"p65PieceGrid emblems\">${(h.emblemPieces||[]).map((p,i)=>p542EmblemCard(id,i,p)).join('')}</div></div></div>`};\n\n// Endgame keeps the new Artifacts/Relics visual even when opened through Battle Hall.\np59ArtifactHtml=function(){return `<div class=\"p65EndEmbed\">${p65ArtifactPane()}</div>`};\np59RelicHtml=function(){return `<div class=\"p65EndEmbed\">${p65RelicPane()}</div>`};\n\n// Actions that previously redrew the old Endgame return to the current premium pane when appropriate.\nfor(const name of ['activateArtifact','levelArtifact','ascendArtifact','levelRelic','starRelic']){\n const base=Game[name];if(typeof base!=='function')continue;\n Game[name]=function(...args){const route=UI.route,tab=UI.p65InvTab;const r=base.apply(Game,args);if(route==='inventory'){UI.route='inventory';UI.p65InvTab=tab;renderInventory()}return r}\n}\n\nsave();\n})();\n\n\n// ===== FASE 6.UI.6 · CRÔNICAS / RENASCIMENTO / CONSTELAÇÃO / DIVINDADE =====\n\n(()=>{\n'use strict';\ntry{state.version='10.5.0-phase6.ui.6'}catch(e){}\nconst p66Esc=v=>String(v??'').replace(/[&<>\\\"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\"'\":'&#39;'}[m]));\nfunction p66ResRail(){return `<div class=\"p66AscRailResources\"><span>♻ Núcleos <b>${fmt(state.resources.rebirth_core||0)}</b></span><span>✦ Pó Estelar <b>${fmt(state.resources.star_dust||0)}</b></span><span>☀ Essência <b>${fmt(state.resources.divinity_essence||0)}</b></span></div>`}\nfunction p66AscRail(id,tab){const h=heroState(id);return `<aside class=\"p66AscRail\"><div class=\"p66AscRailHead\"><small>ASCENSÃO</small><b>${p66Esc(heroBase(id)?.name||'Herói')}</b></div><button class=\"p66AscTab ${tab==='rebirth'?'active':''}\" onclick=\"Game.setAscensionView('rebirth')\"><i>♻</i><span><b>Renascimento</b><small>${h.rebirth||0}/10 ciclos</small></span></button><button class=\"p66AscTab ${tab==='constellation'?'active':''}\" onclick=\"Game.setAscensionView('constellation')\"><i>✦</i><span><b>Constelação</b><small>${p58ConstTotal(h)}/12 estrelas</small></span></button><button class=\"p66AscTab ${tab==='divinity'?'active':''}\" onclick=\"Game.setAscensionView('divinity')\"><i>☀</i><span><b>Divindade</b><small>${h.divinity||0}/15 selos</small></span></button>${p66ResRail()}</aside>`}\nfunction p66Req(ok,label,value){return `<span class=\"${ok?'ok':''}\"><b>${p66Esc(label)}</b><em>${ok?'✓ ':''}${p66Esc(value)}</em></span>`}\nfunction p66Rebirth(id){const h=heroState(id),c=p58RebirthCan(id),n=c.n;return `<div class=\"p66RebirthLayout\"><section class=\"p66RebirthRoad\"><div class=\"p66RebirthNodes\">${P58_REBIRTH.map((x,i)=>`<div class=\"p66RebirthNode ${i<h.rebirth?'done':i===h.rebirth?'next':''}\"><em>${i<h.rebirth?'✦':i===h.rebirth?'◆':'◇'}</em><b>R${i+1}</b><small>${p66Esc(x.name.split(' · ')[1]||x.name)}</small></div>`).join('')}</div></section><aside class=\"p66RebirthSide\">${n?`<small class=\"p66NextKicker\">PRÓXIMO CICLO</small><h4>${p66Esc(n.name)}</h4><p>${p66Esc(n.copy)}</p><div class=\"p66CostLine\"><span>🪙 ${fmt(n.gold)}</span><span>♻ ${n.cores}</span></div><div class=\"p66ReqMini\">${p66Req(state.lab||state.player.level>=n.level,'Jogador','Lv.'+n.level)}${p66Req(state.lab||h.level>=n.level,'Herói','Lv.'+n.level)}${p66Req(state.lab||(h.awakening||0)>=n.awakening,'Despertar',n.awakening+'/36')}${p66Req(state.lab||(h.stars||0)>=n.stars,'Estrelas',n.stars+'★')}${p66Req(state.lab||Number(h.quality||0)>=n.quality,'Qualidade',QN[n.quality]||n.quality)}</div><button class=\"p66AscAction\" onclick=\"Game.rebirthHero('${id}')\" ${!c.ok?'disabled':''}>RENASCER · ${h.rebirth+1}/10</button><div class=\"p66Source\">Fonte: Chefe Épico · Campanha Elite · Endgame</div>`:`<small class=\"p66NextKicker\">CICLO FINAL</small><h4>Renascimento X Completo</h4><p>Uma vez por batalha, um golpe fatal restaura 18% de HP.</p><div class=\"p66Bless\"><b>✦ Imortalidade Renascente</b><small>O marco máximo está ativo neste herói.</small></div>`}</aside></div>`}\nfunction p66ConstPath(id,key){const h=heroState(id),p=P58_CONST[key],lv=h.constellation[key]||0,c=p58ConstCan(id,key);return `<section class=\"p66ConstPath\" style=\"--pc:${p.color}\"><div class=\"p66ConstPathHead\"><i>${p.icon}</i><div><b>${p66Esc(p.name)}</b><small>${p66Esc(p.copy)}</small></div><strong>${lv}/4</strong></div><div class=\"p66ConstStars\">${p.nodes.map((n,i)=>`<div class=\"p66ConstStar ${i<lv?'done':i===lv?'next':''}\"><span>${i<lv?'★':i===lv?'✦':'☆'}</span><div><b>${p66Esc(n.name)}</b><small>${p66Esc(n.copy)}</small></div></div>`).join('')}</div><div class=\"p66ConstAction\">${c.d?`<small>${c.ok?'Pronto para ativar':p66Esc(c.reason)} · 🪙 ${fmt(c.d.gold)} · ✦ ${c.d.dust}</small><button onclick=\"Game.constellationNode('${id}','${key}')\" ${!c.ok?'disabled':''}>ATIVAR ${p66Esc(c.d.name)}</button>`:`<small>Todos os nós deste caminho estão ativos.</small><button disabled>CAMINHO COMPLETO</button>`}</div></section>`}\nfunction p66Constellation(id){return `<div class=\"p66ConstLayout\">${['valor','guard','ether'].map(k=>p66ConstPath(id,k)).join('')}</div>`}\nfunction p66Divinity(id){const h=heroState(id),c=p58DivCan(id),cost=p58DivCost(h),rank=p58DivRank(h),bless=p58RoleBlessing(id,rank);return `<div class=\"p66DivLayout\"><section class=\"p66DivAltar\"><div class=\"p66DivRanks\">${P58_DIVINITY.map((d,i)=>{const seals=Math.max(0,Math.min(3,(h.divinity||0)-i*3));return `<div class=\"p66DivRank ${seals===3?'done':i===Math.floor((h.divinity||0)/3)&&seals<3?'next':''}\"><i>${d.icon}</i><b>${p66Esc(d.name)}</b><div class=\"p66Seals\">${[0,1,2].map(x=>`<span class=\"${x<seals?'on':''}\">${x<seals?'◆':'◇'}</span>`).join('')}</div><small>Lv.${d.level} · R${d.rebirth}</small></div>`}).join('')}</div></section><aside class=\"p66DivSide\"><small class=\"p66NextKicker\">BÊNÇÃO TÁTICA</small><h4>${p66Esc(rank?P58_DIVINITY[Math.max(0,rank-1)]?.name||'Ascendente':'Mortal')}</h4><div class=\"p66Bless\"><b>${p66Esc(bless.label)}</b><small>Cada selo também aumenta os atributos principais do herói.</small></div>${c.stage?`<small class=\"p66NextKicker\">PRÓXIMO SELO</small><h4>${p66Esc(c.stage.name)} · ${(h.divinity%3)+1}/3</h4><div class=\"p66CostLine\"><span>🪙 ${fmt(cost.gold)}</span><span>☀ ${cost.essence}</span></div><div class=\"p66ReqMini\">${p66Req(state.lab||state.player.level>=c.stage.level,'Nível',c.stage.level)}${p66Req(state.lab||(h.rebirth||0)>=c.stage.rebirth,'Renascimento',(h.rebirth||0)+'/'+c.stage.rebirth)}${p66Req(state.lab||p58ConstTotal(h)>=c.stage.constellation,'Constelação',p58ConstTotal(h)+'/'+c.stage.constellation)}</div><button class=\"p66AscAction\" onclick=\"Game.divinitySeal('${id}')\" ${!c.ok?'disabled':''}>ATIVAR SELO DIVINO</button>`:`<div class=\"p66Bless\"><b>☀ Divindade Completa</b><small>Véu Divino após Ultimate e bênção máxima da função tática.</small></div>`}<div class=\"p66Source\">Fonte: Chefe Épico · Endgame · recompensas avançadas</div></aside></div>`}\n\np58AscensionPanel=function(id){p58Ensure();const tab=UI.p58AscensionView||'rebirth',h=heroState(id);const label=tab==='rebirth'?'Renascimento':tab==='constellation'?'Constelação':'Divindade';const sub=tab==='rebirth'?`${h.rebirth||0}/10 ciclos`:tab==='constellation'?`${p58ConstTotal(h)}/12 estrelas`:`${h.divinity||0}/15 selos`;return `<div class=\"p66AscHub\">${p66AscRail(id,tab)}<main class=\"p66AscStage\"><header class=\"p66AscHero\"><div><small>CAMINHO DE ASCENSÃO</small><h3>${label}</h3><p>${tab==='rebirth'?'Rompa os limites do corpo e da alma.':tab==='constellation'?'Especialize o herói em três constelações independentes.':'Conquiste cinco patamares e quinze selos divinos.'}</p></div><strong>${sub}</strong></header><div class=\"p66AscBody\">${tab==='rebirth'?p66Rebirth(id):tab==='constellation'?p66Constellation(id):p66Divinity(id)}</div></main></div>`}\n\nfunction p66Chapter(id,c,i){const h=heroState(id),ch=p59Chron(id),done=!!ch.claimed[c.id],ready=c.req(id,h)||state.lab;return `<article class=\"p66Chapter ${done?'done':ready?'ready':''}\"><div class=\"p66ChapterIcon\">${c.icon}</div><div class=\"p66ChapterCopy\"><small>CAPÍTULO ${i+1}</small><b>${p66Esc(c.name)}</b><p>${p66Esc(p59ChapterCopy(id,c))}</p><span class=\"p66ChapterState\">${done?'✓ Registrado':ready?'Pronto para registrar':'🔒 '+p66Esc(c.reqText)}</span></div><div class=\"p66ChapterReward\"><span>🪙 ${fmt(c.reward.gold)}</span><span>💎 ${c.reward.gems}</span><span>🧩 ${c.reward.fragments||0}</span><span>📖 ${c.reward.pages}</span><button onclick=\"Game.claimChronicle('${id}','${c.id}')\" ${!ready||done?'disabled':''}>${done?'REGISTRADO':'REGISTRAR'}</button></div></article>`}\np59ChroniclePanel=function(id){p59Ensure();const b=heroBase(id),count=p59ChronClaimed(id),pct=count/5*100;return `<div class=\"p66ChronBook\"><aside class=\"p66BookCover\"><div class=\"p66BookSigil\">📖</div><small>CRÔNICAS DE NERDORA</small><h3>${p66Esc(b.name)}</h3><p>${p66Esc(p59HeroLore(id))}</p><div class=\"p66BookProgress\"><div><i style=\"width:${pct}%\"></i></div><span><b>${count}/5 capítulos</b><em>${Math.round(pct)}%</em></span></div><div class=\"p66BookBonus\">Cada capítulo: <b>+1% HP / ATQ / DEF</b><br>Livro completo: <b>+50 Energia inicial</b></div></aside><main class=\"p66BookPages\"><header class=\"p66PageHead\"><div><small>LIVRO DO HERÓI</small><b>Registre feitos para escrever a história.</b></div><strong>📖 ${state.resources.chronicle_page||0}</strong></header><div class=\"p66BookChapters\">${P59_CHAPTERS.map((c,i)=>p66Chapter(id,c,i)).join('')}</div></main></div>`}\n\np59ChronicleEndHtml=function(){p59Ensure();const total=p59ArchiveCount(),max=D.heroes.length*P59_CHAPTERS.length;return `<div class=\"p66Archive\"><aside class=\"p66ArchiveSide\"><small>ARQUIVO GLOBAL</small><h3>${total}/${max} capítulos</h3><p>A Biblioteca reúne as histórias concluídas dos 40 heróis e libera marcos globais.</p><div class=\"p66BookProgress\"><div><i style=\"width:${Math.min(100,total/max*100)}%\"></i></div><span><b>${Math.round(total/max*100)}%</b><em>📖 ${state.resources.chronicle_page||0}</em></span></div><div class=\"p66ArchiveMilestones\">${P59_ARCHIVE.map(m=>{const got=!!state.phase59.archiveClaimed[m.need],ready=total>=m.need;return `<div class=\"p66ArchiveMilestone ${got?'done':ready?'ready':''}\"><b>${p66Esc(m.name)}</b><span>${total}/${m.need} capítulos</span><button onclick=\"Game.claimChronicleArchive(${m.need})\" ${got||!ready?'disabled':''}>${got?'✓ COLETADO':'COLETAR'}</button></div>`}).join('')}</div></aside><section class=\"p66ArchiveGrid\">${D.heroes.map(b=>{const h=heroState(b.id),c=p59ChronClaimed(b.id),wins=p59Chron(b.id).wins,src=PHASE5_HERO_ASSETS[b.id];return `<button class=\"p66ArchiveHero\" onclick=\"Game.openChronicleHero('${b.id}')\" ${!h.owned?'disabled':''}><figure>${src?`<img src=\"${src}\" alt=\"${p66Esc(b.name)}\">`:`<span>${b.emoji||'◈'}</span>`}</figure><div><b>${p66Esc(b.name)}</b><small>${h.owned?`${c}/5 capítulos · ${wins} vitórias`:'Não obtido'}</small></div><strong>${c===5?'👑':c+'/5'}</strong></button>`}).join('')}</section></div>`}\n\n// Atualiza o subtítulo técnico visível na Central do Herói sem expor número de fase antigo.\nconst p66HeroDetailBase=heroDetailHtml;\nheroDetailHtml=function(id,tab){let out=p66HeroDetailBase(id,tab);out=out.replace(/CENTRAL DO HERÓI/g,'CENTRAL DO HERÓI').replace(/FASE 5\\.9 · LEGADOS E CRÔNICAS/g,'CENTRAL DO HERÓI').replace(/FASE 5\\.8 · ENDGAME DO HERÓI/g,'CENTRAL DO HERÓI');return out}\n\ntry{document.title='Nerdora Chibi Raiders — Ascensão & Crônicas'}catch(e){}\ntry{if(window.NerdoraUI?.enhance)setTimeout(()=>NerdoraUI.enhance(),0)}catch(e){}\n})();\n\n/* ===== FASE 6.UI.7 · GUILDA / MISSÕES / LOJA / CONFIGURAÇÕES ===== */\n\n(()=>{\n  try{state.version='10.6.0-phase6.ui.7'}catch(e){}\n  const esc=v=>String(v??'').replace(/[&<>\"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[m]));\n  const pct=(a,b)=>Math.max(0,Math.min(100,b?Number(a||0)/Number(