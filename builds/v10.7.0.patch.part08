>💎 ${fmt(state.player.gems)}</b><small>🪙 ${fmt(state.player.gold)} ouro</small></div>${[['resources','◆','Recursos'],['currencies','◇','Lojas especiais'],['info','i','Economia']].map(x=>`<button class=\"${tab===x[0]?'active':''}\" onclick=\"Game.p67ShopTab('${x[0]}')\"><span>${x[1]}</span>${x[2]}</button>`).join('')}</aside><main class=\"p67ShopMain\"><header class=\"p67ShopHero\"><small>CENTRAL DE SUPRIMENTOS</small><h3>${tab==='resources'?'Recursos':tab==='currencies'?'Lojas especiais':'Economia'}</h3><p>${tab==='resources'?'Compras diretas com Gemas.':tab==='currencies'?'Acesse as moedas e lojas dos modos de jogo.':'Resumo da sua carteira e fontes de progressão.'}</p></header><div class=\"p67ShopScroll\">${content}</div></main></div>`}\n  Game.p67ShopTab=function(tab){UI.p67ShopTab=tab;const body=document.getElementById('ui61WindowBody');if(body)body.innerHTML=shopHtml();else Game.openShop(tab)};\n  Game.p67ShopGo=function(route,tab){window.NerdoraUI?.closeWindow?.();if(route==='modes'&&tab){UI.modeTab=tab}if(route==='guild')UI.p67GuildTab='shop';UI.nav(route)};\n  Game.openShop=function(tab){if(tab)UI.p67ShopTab=tab;const content=shopHtml();if(window.NerdoraUI?.openWindow){NerdoraUI.openWindow('Loja de Nerdora',content,{className:'p67ShopWindow'})}else UI.openModal('Loja de Nerdora',content)};\n  Game.buyShop=function(key,amt,cost){if(state.player.gems<cost)return toast('Gemas insuficientes');state.player.gems-=cost;addResource(key,amt);save();toast('Compra concluída');const body=document.getElementById('ui61WindowBody');if(body&&document.getElementById('ui61Window')?.classList.contains('show'))body.innerHTML=shopHtml()};\n\n  const oldRender=window.render;if(typeof oldRender==='function'){window.render=function(){oldRender();try{const v=document.querySelector('.cityVersion');if(v)v.textContent='v10.6.0'}catch(e){}applyPrefs()};try{render=window.render}catch(e){}}\n  save();\n})();\n\n\n\n\n// ===== FASE 6.UI.8 · COMBATE / VFX / VITÓRIA / DERROTA =====\n(()=>{\n'use strict';\ntry{state.version='10.7.0-phase6.ui.8'}catch(e){}\nconst p68Esc=v=>String(v??'').replace(/[&<>\"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[m]));\nconst p68ModeName=m=>({campaign:'Campanha',elite:'Campanha Elite',arena:'Arena',boss:'Chefe Épico',guildBoss:'Chefe da Guilda',weeklyRaid:'Incursão Semanal',angelTrial:'Provação Celestial',heroTrial:'Provação do Herói',goldTrial:'Provação de Ouro',relicDungeon:'Masmorra de Relíquias'}[m]||'Batalha');\nfunction p68Alive(side){return (side||[]).filter(x=>!x.dead).length}\nfunction p68InitStats(){Battle.p68Stats={dealt:0,taken:0,healing:0,crits:0,dodges:0,blocks:0,kills:0,startedAt:Date.now()}}\nfunction p68Stats(){return Battle.p68Stats||(Battle.p68Stats={dealt:0,taken:0,healing:0,crits:0,dodges:0,blocks:0,kills:0,startedAt:Date.now()})}\nfunction p68Pos(u){const idx={'F1':0,'F2':1,'B1':0,'B2':1,'B3':2}[u.slot]??0,player=u.side==='player';return {x:player?(u.line==='back'?3:25):(u.line==='front'?60:82),y:u.line==='front'?(idx===0?25:61):(idx===0?12:idx===1?42:72)}}\nfunction p68Portrait(u){const src=u.side==='player'&&typeof PHASE5_HERO_ASSETS!=='undefined'?PHASE5_HERO_ASSETS[u.id]:null;return src?`<img src=\"${src}\" alt=\"${p68Esc(u.name)}\">`:`<span>${u.emoji||'◆'}</span>`}\nfunction p68Status(u){return (u.buffs||[]).map(x=>{const b=D.buffs[x.id];return b?`<i title=\"${p68Esc(b.name)}\">${b.icon||'•'}</i>`:''}).join('')}\nfunction p68UnitHtml(u){const p=p68Pos(u),hp=clamp(u.hp/u.maxHp*100,0,100),rage=clamp(u.energy/10,0,100),low=hp<=30;return `<article class=\"unitCard p68Unit ${u.side} ${u.dead?'dead':''} ${low?'lowhp':''}\" data-uid=\"${u.uid}\" data-slot=\"${u.slot}\" style=\"left:${p.x}%;top:${p.y}%\"><div class=\"p68Portrait\">${p68Portrait(u)}<em>${u.slot}</em></div><div class=\"p68UnitCore\"><div class=\"p68UnitTop\"><b>${p68Esc(u.name)}</b><span>${u.line==='front'?'FRONT':'BACK'} · AGI ${Math.round(u.agility)}</span></div><div class=\"p68BarRow\"><small>HP</small><div class=\"p68Bar hp\"><i style=\"width:${hp}%\"></i></div><strong>${Math.ceil(u.hp)}</strong></div><div class=\"p68BarRow rage\"><small>RAGE</small><div class=\"p68Bar\"><i style=\"width:${rage}%\"></i></div><strong>${u.energy}</strong></div><div class=\"p68Status\">${p68Status(u)}</div>${u.side==='player'?`<button class=\"p68Ult ${u.energy>=1000?'ready':''} ${u.queuedUltimate?'queued':''}\" onclick=\"Battle.queueUlt('${u.uid}')\" ${u.energy<1000||u.dead?'disabled':''}>${u.queuedUltimate?'ULT PREPARADA':u.energy>=1000?'ULTIMATE PRONTA':'ULTIMATE'}</button>`:''}</div></article>`}\nfunction p68Hud(){const arena=$('#battleArena');if(!arena)return;let el=arena.querySelector('.p68BattleHud');const s=p68Stats(),html=`<div class=\"p68Team p\"><small>SEU TIME</small><b>${p68Alive(Battle.player)}/${Battle.player.length}</b></div><div class=\"p68Round\"><small>${p68ModeName(Battle.ctx?.mode)}</small><b>RODADA ${Battle.round}</b><span>${Battle.waveTotal>1?`WAVE ${Battle.waveIndex}/${Battle.waveTotal}`:'CONFRONTO ÚNICO'}</span></div><div class=\"p68Team e\"><small>INIMIGOS</small><b>${p68Alive(Battle.enemy)}/${Battle.enemy.length}</b></div>`;if(!el){arena.insertAdjacentHTML('beforeend',`<section class=\"p68BattleHud\">${html}</section>`)}else el.innerHTML=html;let metrics=arena.querySelector('.p68Metrics');const m=`<span><small>DANO</small><b>${fmt(s.dealt)}</b></span><span><small>CRÍT.</small><b>${s.crits}</b></span><span><small>ESQUIVAS</small><b>${s.dodges}</b></span>`;if(!metrics)arena.insertAdjacentHTML('beforeend',`<aside class=\"p68Metrics\">${m}</aside>`);else metrics.innerHTML=m}\nfunction p68Pulse(u,type='skill'){const card=document.querySelector(`[data-uid=\"${u.uid}\"]`);if(!card)return;card.classList.remove('p68Act','p68UltAct');void card.offsetWidth;card.classList.add(type==='ultimate'?'p68UltAct':'p68Act');setTimeout(()=>card.classList.remove('p68Act','p68UltAct'),type==='ultimate'?720:430)}\nfunction p68Impact(t,res){const arena=$('#battleArena'),card=document.querySelector(`[data-uid=\"${t.uid}\"]`);if(!arena||!card)return;card.classList.remove('p68Hit','p68CritHit','p68BlockHit','p68DodgeHit');void card.offsetWidth;const cls=!res.hit?'p68DodgeHit':res.crit?'p68CritHit':res.block?'p68BlockHit':'p68Hit';card.classList.add(cls);const r=card.getBoundingClientRect(),a=arena.getBoundingClientRect(),fx=document.createElement('i');fx.className='p68Impact '+(res.crit?'crit':res.block?'block':!res.hit?'dodge':'');fx.style.left=(r.left-a.left+r.width/2)+'px';fx.style.top=(r.top-a.top+r.height/2)+'px';arena.appendChild(fx);setTimeout(()=>{card.classList.remove(cls);fx.remove()},res.crit?620:430)}\nfunction p68UltBanner(u,skill){const arena=$('#battleArena');if(!arena||!u||!skill)return;arena.querySelector('.p68UltBanner')?.remove();const src=u.side==='player'&&typeof PHASE5_HERO_ASSETS!=='undefined'?PHASE5_HERO_ASSETS[u.id]:null;arena.insertAdjacentHTML('beforeend',`<div class=\"p68UltBanner ${u.side}\">${src?`<img src=\"${src}\" alt=\"\">`:`<i>${u.emoji||'★'}</i>`}<div><small>ULTIMATE</small><b>${p68Esc(skill.name)}</b><span>${p68Esc(u.name)}</span></div></div>`);setTimeout(()=>arena.querySelector('.p68UltBanner')?.remove(),900)}\nfunction p68DecorateShell(){const bs=$('#battleScreen'),arena=$('#battleArena');if(!bs||!arena)return;bs.classList.add('p68Battle');const top=bs.querySelector('.battleTop');if(top){top.querySelector('#battleTitle')?.classList.add('p68Title');const exit=top.querySelector('button');if(exit)exit.innerHTML='‹ SAIR';const pb=$('#pauseBtn'),sp=$('#speedBtn'),au=$('#autoBtn');if(pb)pb.textContent=Battle.paused?'▶':'Ⅱ';if(sp)sp.textContent=`${Battle.speed}×`;if(au)au.textContent=Battle.autoUlt?'ULT AUTO':'ULT MANUAL'}p68Hud()}\nfunction p68DecorateResult(win){const host=$('#battleResult'),card=host?.querySelector('.resultCard');if(!card||card.dataset.p68==='1')return;card.dataset.p68='1';card.classList.add('p68Result',win?'victory':'defeat');const s=p68Stats(),duration=Math.max(1,Math.round((Date.now()-(s.startedAt||Date.now()))/1000)),mode=p68ModeName(Battle.ctx?.mode),summary=document.createElement('div');summary.className='p68ResultSummary';summary.innerHTML=`<div class=\"p68ResultKicker\">${win?'MISSÃO CONCLUÍDA':'BATALHA ENCERRADA'} · ${p68Esc(mode)}</div><div class=\"p68ResultStats\"><span><small>RODADAS</small><b>${Battle.round}</b></span><span><small>DANO CAUSADO</small><b>${fmt(s.dealt)}</b></span><span><small>CRÍTICOS</small><b>${s.crits}</b></span><span><small>TEMPO</small><b>${duration}s</b></span></div>`;const reward=card.querySelector('.rewardRow'),h=card.querySelector('h2');if(reward)card.insertBefore(summary,reward);else if(h)h.after(summary);else card.prepend(summary);const icon=card.firstElementChild;if(icon&&!icon.classList.contains('p68ResultSummary'))icon.classList.add('p68ResultIcon');const btns=card.querySelectorAll('button');btns.forEach(b=>b.classList.add('p68ResultButton'))}\nconst p68StartBase=Battle.start.bind(Battle);Battle.start=function(ctx){p68InitStats();const r=p68StartBase(ctx);setTimeout(()=>{p68DecorateShell();p68Hud()},0);return r};\nconst p68ShellBase=Battle.renderShell.bind(Battle);Battle.renderShell=function(full=true){const r=p68ShellBase(full);p68DecorateShell();return r};\nBattle.unitHtml=function(u){return p68UnitHtml(u)};\nconst p68UnitsBase=Battle.renderUnits.bind(Battle);Battle.renderUnits=function(){const r=p68UnitsBase();p68Hud();return r};\nconst p68OrderBase=Battle.renderOrder.bind(Battle);Battle.renderOrder=function(){const r=p68OrderBase();const e=$('#battleOrder');if(e){e.classList.add('p68Order');e.innerHTML=this.order.filter(u=>!u.dead).map((u,i)=>`<span class=\"orderChip ${i===this.current?'current':''} ${u.side}\"><i>${u.emoji||'◆'}</i><b>${Math.round(this.effectiveAgi(u))}</b></span>`).join('')}p68Hud();return r};\nconst p68MarkBase=Battle.markActive.bind(Battle);Battle.markActive=function(u){const r=p68MarkBase(u);p68Pulse(u,'skill');return r};\nconst p68BasicBase=Battle.basic.bind(Battle);Battle.basic=function(u){