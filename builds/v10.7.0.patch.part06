b)*100:0));\n  const guildMembers=[['👑','Nerdola','Mestre','86k'],['🐱','Nyan','Oficial','72k'],['⚔️','Astra','Veterano','61k'],['🧙','Lumi','Membro','54k'],['🏹','Kael','Membro','49k']];\n  UI.p67GuildTab=UI.p67GuildTab||'hall';UI.p67MissionTab=UI.p67MissionTab||'daily';UI.p67SettingsTab=UI.p67SettingsTab||'game';UI.p67ShopTab=UI.p67ShopTab||'resources';\n  state.phase67Prefs={reducedMotion:false,compactHud:false,...(state.phase67Prefs||{})};\n  function applyPrefs(){document.documentElement.classList.toggle('p67ReduceMotion',!!state.phase67Prefs.reducedMotion);document.body?.classList.toggle('p67CompactHud',!!state.phase67Prefs.compactHud)}\n  applyPrefs();\n  function rail(title,sub,tabs,active,handler){return `<aside class=\"p67Rail\"><div class=\"p67RailHead\"><small>${esc(sub)}</small><b>${esc(title)}</b></div>${tabs.map(t=>`<button class=\"${active===t[0]?'active':''}\" onclick=\"${handler}('${t[0]}')\"><i>${t[1]}</i><span><b>${esc(t[2])}</b><small>${esc(t[3]||'')}</small></span>${t[4]!==undefined?`<em>${t[4]}</em>`:''}</button>`).join('')}<div class=\"p67RailFoot\">FASE 6.UI.7<br>Interface fixa · painéis internos</div></aside>`}\n  function hero(kicker,name,copy,stats=[]){return `<header class=\"p67Hero\"><div><small>${esc(kicker)}</small><h2>${esc(name)}</h2><p>${esc(copy)}</p></div><div class=\"p67HeroStats\">${stats.map(x=>`<span><small>${esc(x[0])}</small><b>${x[1]}</b></span>`).join('')}</div></header>`}\n  function shell(left,head,body){return `<div class=\"p67Shell\">${left}<section class=\"p67Stage\">${head}<div class=\"p67Body\">${body}</div></section></div>`}\n  UI.p67Guild=function(tab){UI.p67GuildTab=tab;renderGuild()};UI.p67Mission=function(tab){UI.p67MissionTab=tab;renderMissions()};UI.p67Settings=function(tab){UI.p67SettingsTab=tab;renderSettings()};\n\n  function guildHall(g){const need=Math.max(1,g.level*300);return `<div class=\"p67Grid2\"><section class=\"p67GuildBanner\"><div><small class=\"tiny\">ORDEM ATIVA · NÍVEL ${g.level}</small><h3>🏰 ${esc(g.name)}</h3><p>Tecnologia coletiva, doações, chefe e recompensas em uma única sede.</p><div class=\"p67Progress\"><i style=\"width:${pct(g.xp,need)}%\"></i></div><small class=\"tiny\">${fmt(g.xp)} / ${fmt(need)} EXP da Guilda</small></div><div class=\"p67GuildCrest\">🛡️</div></section><section class=\"p67Card\"><div class=\"p67CardHead\"><div><small>BÔNUS DA ORDEM</small><b>Tecnologias ativas</b></div><i>✦</i></div><div class=\"p67BonusRow\"><span>⚔ ATQ <b>+${(g.tech.attack||0)*2}%</b></span><span>❤️ HP <b>+${(g.tech.hp||0)*2}%</b></span><span>🛡 DEF <b>+${(g.tech.defense||0)*2}%</b></span></div></section><section class=\"p67Card\"><div class=\"p67CardHead\"><div><small>CONTRIBUIÇÃO</small><b>Doações diárias</b></div><i>🎁</i></div><div class=\"p67Donate\"><div><b>🪙 Doação de Ouro</b><small>10.000 ouro → 80 moedas + 50 EXP</small></div><button class=\"p67Btn gold\" onclick=\"Game.guildDonate('gold')\" ${g.donations>=3?'disabled':''}>DOAR</button></div><div class=\"p67Donate\"><div><b>💎 Doação Premium</b><small>100 gemas → 160 moedas + 100 EXP</small></div><button class=\"p67Btn violet\" onclick=\"Game.guildDonate('gems')\" ${g.donations>=3?'disabled':''}>DOAR</button></div></section><section class=\"p67Card\"><div class=\"p67CardHead\"><div><small>ATIVIDADE</small><b>Resumo da sede</b></div><i>📜</i></div><div class=\"p67BonusRow\"><span>Doações <b>${g.donations}/3</b></span><span>Boss <b>${g.bossTries||0}</b></span><span>Moedas <b>${fmt(state.currencies.guild||0)}</b></span></div></section></div>`}\n  function guildTech(g){return `<div class=\"p67TechGrid\">${D.phase4.guildTech.map(t=>{const lv=g.tech[t.id]||0,cost=120+lv*60;return `<article class=\"p67Tech\"><i>${t.icon}</i><h4>${esc(t.name)}</h4><p>${esc(t.desc)}</p><div class=\"p67TechFoot\"><span>Nv.${lv}/${t.max}</span><button class=\"p67Btn violet\" onclick=\"Game.guildTech('${t.id}')\" ${lv>=t.max?'disabled':''}>${lv>=t.max?'MÁXIMO':`${cost} 🏰`}</button></div></article>`}).join('')}</div>`}\n  function guildBoss(g){return `<div class=\"p67Boss\"><section class=\"p67BossStage\"><h3>Devorador Astral</h3><p>Chefe cooperativo da Guilda. Use sua melhor formação para superar o recorde semanal da Ordem.</p><div><button class=\"p67Btn red\" onclick=\"Game.startGuildBoss()\" ${g.bossTries<=0?'disabled':''}>${g.bossTries>0?'DESAFIAR CHEFE':'TENTATIVA UTILIZADA'}</button></div></section><aside class=\"p67BossPanel\"><div class=\"p67Card\"><div class=\"p67CardHead\"><div><small>RECORDE SEMANAL</small><b>Melhor dano</b></div><i>💥</i></div><h3 style=\"margin:0;color:#f0cc83\">${fmt(g.bossBest||0)}</h3></div><div class=\"p67Card\"><div class=\"p67CardHead\"><div><small>ENTRADA</small><b>Tentativas restantes</b></div><i>⚔️</i></div><div class=\"p67BonusRow\"><span>Hoje <b>${g.bossTries||0}</b></span><span>Moedas <b>${fmt(state.currencies.guild||0)}</b></span><span>Equipe <b>${Object.values(state.formation||{}).filter(Boolean).length}/5</b></span></div></div><div class=\"p67Card\"><b style=\"font-size:5.5px\">Recompensas principais</b><p>Moedas da Guilda, Pó de Relíquia e progresso coletivo.</p></div></aside></div>`}\n  function guildShop(g){return `<div class=\"p67ShopRows\">${D.phase4.guildShop.map(it=>{const bought=!!g.shopBought?.[it.id];return `<article class=\"p67ShopRow\"><i>${it.icon}</i><div><b>${esc(it.name)}</b><small>${it.cost} moedas da Guilda · compra da rotação atual</small></div><button class=\"p67Btn ${bought?'green':'gold'}\" onclick=\"Game.buyGuildShop('${it.id}')\" ${bought?'disabled':''}>${bought?'COMPRADO':`${it.cost} 🏰`}</button></article>`}).join('')}</div>`}\n  function guildMembersHtml(){return `<div class=\"p67MemberList\">${guildMembers.map((m,i)=>`<article class=\"p67Member\"><i>${m[0]}</i><div><b>${m[1]}</b><small>${m[2]} · Poder ${m[3]}</small></div><small class=\"p67Online\">${i<4?'● ONLINE':'● ATIVO'}</small></article>`).join('')}</div>`}\n  window.renderGuild=function(){\n    if(!isUnlocked('guild')){$('#screen').innerHTML=`${title('Guilda','Desbloqueia no nível 22')}<div class=\"p67Card\" style=\"max-width:620px;margin:auto;text-align:center\"><div style=\"font-size:52px\">🔒</div><h2 style=\"color:#edd59c\">Sede da Guilda bloqueada</h2><p>Alcance o nível 22 para liberar doações, tecnologias, Chefe da Guilda, loja e membros.</p></div>`;return}\n    if(!state.guild.joined){$('#screen').innerHTML=`${title('Guilda','Sede social e progressão coletiva')}<div class=\"p67GuildBanner\" style=\"max-width:760px;margin:auto\"><div><small class=\"tiny\">RECRUTAMENTO ABERTO</small><h3>Ordem de Nerdora</h3><p>Entre na Ordem para liberar tecnologia coletiva, Chefe da Guilda, doações e moeda exclusiva.</p><button class=\"p67Btn violet\" onclick=\"Game.joinGuild()\">ENTRAR NA GUILDA</button></div><div class=\"p67GuildCrest\">🏰</div></div>`;return}\n    const g=state.guild,tabs=[['hall','🏰','Sede','Visão geral'],['tech','✦','Tecnologia','Bônus coletivos'],['boss','🐲','Chefe','Desafio diário'],['shop','◆','Loja','Moeda da Guilda'],['members','👥','Membros','Ordem ativa']];\n    const left=rail(g.name,'GUILDA',tabs,UI.p67GuildTab,'UI.p67Guild');\n    const head=hero('ORDEM DE NERDORA',g.name,'Progressão coletiva e atividades da Guilda',[['NÍVEL',g.level],['MOEDAS',fmt(state.currencies.guild||0)],['DOAÇÕES',`${g.donations||0}/3`],['BOSS',g.bossTries||0]]);\n    const views={hall:guildHall(g),tech:guildTech(g),boss:guildBoss(g),shop:guildShop(g),members:guildMembersHtml()};$('#screen').innerHTML=`${title('Guilda','Sede da Ordem')} ${shell(left,head,views[UI.p67GuildTab]||views.hall)}`;\n  };\n  try{renderGuild=window.renderGuild}catch(e){}\n\n  function rewardChips(reward){return Object.entries(reward||{}).map(([k,v])=>`<span>${esc(rewardName(k))} +${fmt(v)}</span>`).join('')}\n  function dailyMission(m){const cur=Math.min(m.need,state.daily[m.key]||0),done=cur>=m.need,claimed=!!state.daily.claimed[m.id];return `<article class=\"p67Mission ${claimed?'done':done?'ready':''}\"><i>${m.icon}</i><div><b>${esc(m.name)}</b><small>${cur}/${m.need}</small><div class=\"p67Progress\"><i style=\"width:${pct(cur,m.need)}%\"></i></div><div class=\"p67MissionReward\">${rewardChips(m.reward)}</div></div><div class=\"p67MissionAction\"><button class=\"p67Btn ${done&&!claimed?'gold':claimed?'green':''}\" onclick=\"Game.claimMission('${m.id}')\" ${!done||claimed?'disabled':''}>${claimed?'COLETADO':'COLETAR'}</button></div></article>`}\n  function weeklyMission(m){const cur=Math.min(m.need,state.weekly[m.key]||0),done=cur>=m.need,claimed=!!state.weekly.claimed[m.id];return `<article class=\"p67Mission ${claimed?'done':done?'ready':''}\"><i>${m.icon}</i><div><b>${esc(m.name)}</b><small>${cur}/${m.need}</small><div class=\"p67Progress\"><i style=\"width:${pct(cur,m.need)}%\"></i></div><div class=\"p67MissionReward\">${rewardChips(m.reward)}</div></div><div class=\"p67MissionAction\"><button class=\"p67Btn ${done&&!claimed?'gold':claimed?'green':''}\" onclick=\"Game.claimWeekly('${m.id}')\" ${!done||claimed?'disabled':''}>${claimed?'COLETADO':'COLETAR'}</button></div></article>`}\n  function missionDailyView(){const claim=missionDefs.filter(m=>(state.daily[m.key]||0)>=m.need&&!state.daily.claimed[m.id]).length,done=missionDefs.filter(m=>state.daily.claimed[m.id]).length;return `<div class=\"p67MissionSummary\"><span><small>CONCLUÍDAS</small><b>${done}/${missionDefs.length}</b></span><span><small>PRONTAS</small><b>${claim}</b></span><span><small>ENERGIA GASTA</small><b>${state.daily.energySpent||0}</b></span><span><small>BATALHAS</small><b>${state.daily.battle||0}</b></span></div><div style=\"display:flex;justify-content:flex-end;margin-bottom:5px\"><button class=\"p67Btn gold\" onclick=\"Game.p67ClaimAllDaily()\" ${claim?'':'disabled'}>COLETAR TODAS (${claim})</button></div><div class=\"p67MissionList\">${missionDefs.map(dailyMission).join('')}</div>`}\n  function missionWeeklyView(){const defs=D.phase4.weeklyMissions||[],done=defs.filter(m=>state.weekly.claimed[m.id]).length;return `<div class=\