utton><button onclick=\"Game.summon('normal',10)\"><small>INVOCAR 10X</small><b>${fmt(D.gacha.normal.tenCost)} 🪙</b></button></div></section><section class=\"p64Portal premium\"><div class=\"p64PortalGlow\"></div><div class=\"p64PortalOrb\"><i></i><span>✦</span></div><div class=\"p64PortalCopy\"><small>PORTAL CELESTIAL</small><h2>${esc(D.gacha.premium.name)}</h2><p>Maior chance de raridades elevadas. A invocação 10x garante SR ou superior.</p><div class=\"p64Rates\">${p64PortalRates('premium')}</div><em class=\"p64Free\">${free?'✦ INVOCAÇÃO GRATUITA DISPONÍVEL':'Próxima gratuita · '+freeTime()}</em></div><div class=\"p64PortalActions\"><button class=\"premium\" onclick=\"Game.summon('premium',1)\"><small>${free?'GRÁTIS':'INVOCAR 1X'}</small><b>${free?'ABRIR AGORA':fmt(D.gacha.premium.singleCost)+' 💎'}</b></button><button class=\"premium\" onclick=\"Game.summon('premium',10)\"><small>INVOCAR 10X</small><b>${fmt(D.gacha.premium.tenCost)} 💎</b></button></div></section><div id=\"summonResults\" class=\"p64SummonResults\"></div></div>`;if(window.NerdoraUI?.enhance)setTimeout(()=>NerdoraUI.enhance(),0)};\nconst p64SummonBase=Game.summon.bind(Game);\nGame.summon=function(...args){p64SummonBase(...args);const box=$('#summonResults');if(box&&box.innerHTML.trim()&&window.NerdoraUI){const html=`<div class=\"p64SummonWindow\">${box.innerHTML}</div>`;box.innerHTML='';NerdoraUI.openWindow('Resultado da Invocação',html)}};\n\nfunction p64ModeTabs(){const tabs=[['core','⚔','Batalhas'],['trials','♜','Provações'],['arena','◇','Arena'],['events','✦','Eventos'],['shops','◆','Lojas'],['endgame','☀','Endgame']];return `<nav class=\"p64ModeTabs\">${tabs.map(([k,i,n])=>`<button class=\"${UI.modeTab===k?'active':''}\" onclick=\"UI.p64Mode('${k}')\"><i>${i}</i><span>${n}</span></button>`).join('')}</nav>`}\nfunction p64CoreModes(){const floor=state.phase56?.towerFloor||1,best=state.phase56?.towerBest||0;return `<div class=\"p64CoreGrid\"><article class=\"p64ModeHero campaign\"><div class=\"p64ModeSigil\">⚔</div><small>JORNADA PRINCIPAL</small><h2>Campanha</h2><p>Avance pelos capítulos, conquiste estrelas e equipe sua formação.</p><div class=\"p64ModeStats\"><span>⭐ ${Object.values(state.campaign.completed).reduce((a,x)=>a+(x.stars||0),0)}</span><span>⚡ ${state.player.energy}/${state.player.maxEnergy}</span></div><button onclick=\"UI.nav('campaign')\">ABRIR CAMPANHA</button></article><article class=\"p64ModeHero tower\"><div class=\"p64ModeSigil\">♜</div><small>DESAFIO ASCENDENTE</small><h2>Torre Eterna</h2><p>Suba andar por andar e fortaleça suas Runas.</p><div class=\"p64ModeStats\"><span>Andar ${floor}</span><span>Recorde ${best}</span><span>${state.phase56?.towerTries??5}/5</span></div><button onclick=\"Game.p64TowerWindow()\">VER TORRE</button></article><article class=\"p64ModeHero arena\"><div class=\"p64ModeSigil\">◇</div><small>PVP ASSÍNCRONO</small><h2>Arena</h2><p>Defesa própria, rivais Nerdora e ranking sazonal.</p><div class=\"p64ModeStats\"><span>${leagueName()}</span><span>#${state.arena.rank}</span><span>${state.arena.tries}/5</span></div><button onclick=\"UI.p64Mode('arena')\">ABRIR ARENA</button></article><article class=\"p64ModeHero boss\"><div class=\"p64ModeSigil\">🐉</div><small>CHEFE ÉPICO</small><h2>Colosso do Vazio</h2><p>Conteúdo diário de alta dificuldade com loot avançado.</p><div class=\"p64ModeStats\"><span>${state.phase56?.bossTries??3}/3 tentativas</span><span>Melhor ${fmt(state.phase56?.bossBest||0)}</span></div><button onclick=\"Game.p64BossWindow()\">PREPARAR BOSS</button></article></div>`}\nfunction p64LegacyPanel(tab){const fn=tab==='trials'?trialsHtml:tab==='events'?eventsHtml:tab==='shops'?shopsHtml:endgameHtml;return `<div class=\"p64LegacyPanel\">${fn()}</div>`}\nfunction p64ArenaOffline(){return `<div class=\"p64ArenaOffline\"><div class=\"p64ArenaCrest\">◇</div><div><small>ARENA NERDORA</small><h2>Abra pelo Nerdora para ativar o PvP Online</h2><p>A Arena simulada continua disponível para testar sua formação sem conexão.</p><div class=\"p64ArenaLocalStats\"><span>🏅 ${state.arena.wins||0} vitórias</span><span>🏆 #${state.arena.rank}</span><span>⚔ ${state.arena.tries}/5</span></div><button onclick=\"Game.startArena()\" ${state.arena.tries<=0?'disabled':''}>INICIAR ARENA SIMULADA</button></div></div>`}\nfunction p64ArenaOnline(){if(!P602.status&&!P602.loading)setTimeout(()=>p602Request('status'),0);const me=P602.status?.me||{},left=P602.status?.attacksLeft??5,rank=P602.status?.rank||'—';const tab=P64.arenaTab;let body='';if(tab==='rivals')body=`<div class=\"p64ArenaList\">${P602.loading?'<div class=\"p602Loading\">Conectando à Arena Nerdora...</div>':(P602.opponents?.length?P602.opponents.map(p602ArenaCard).join(''):'<div class=\"p64Empty\">Nenhum rival carregado. Sincronize sua defesa e atualize.</div>')}</div>`;else if(tab==='ranking')body=p602LeaderboardHtml();else if(tab==='history')body=p602HistoryHtml();else body=`<div class=\"p64DefensePanel\"><div class=\"defenseSlots\">${Object.values(state.arena.defense||{}).filter(Boolean).map(id=>`<div class=\"defSlot\">${PHASE5_HERO_ASSETS[id]?`<img src=\"${PHASE5_HERO_ASSETS[id]}\" alt=\"${heroBase(id)?.name||''}\">`:(heroBase(id)?.emoji||'?')}<span>${heroBase(id)?.name||''}</span></div>`).join('')}</div><div><small>PODER DEFENSIVO</small><b>⚔ ${fmt(defensePower())}</b></div><button onclick=\"Game.copyArenaDefense();Game.p602PublishDefense()\">COPIAR FORMAÇÃO E PUBLICAR</button></div>`;return `<div class=\"p64ArenaShell\"><header class=\"p64ArenaHero\"><div><small>ARENA ONLINE · TEMPORADA ${esc(P602.status?.season||'ATUAL')}</small><h2>${p602League(me.rating||1200)}</h2><p>Enfrente formações publicadas pela comunidade Nerdora.</p><div class=\"p64ArenaStats\"><span>🏆 #${rank}</span><span>🎖 ${me.rating||1200}</span><span>⚔ ${left}/5</span><span>✅ ${me.wins||0}V</span><span>❌ ${me.losses||0}D</span></div></div><div><button onclick=\"Game.p602PublishDefense()\">🛡 PUBLICAR DEFESA</button><button onclick=\"Game.p602RefreshArena()\">↻ ATUALIZAR</button></div></header>${P602.error?`<div class=\"p602Error\">⚠ ${esc(P602.error)}</div>`:''}<nav class=\"p64ArenaTabs\"><button class=\"${tab==='rivals'?'active':''}\" onclick=\"UI.p64ArenaTab('rivals')\">⚔ Rivais</button><button class=\"${tab==='ranking'?'active':''}\" onclick=\"UI.p64ArenaTab('ranking')\">🏆 Ranking</button><button class=\"${tab==='defense'?'active':''}\" onclick=\"UI.p64ArenaTab('defense')\">🛡 Defesa</button><button class=\"${tab==='history'?'active':''}\" onclick=\"UI.p64ArenaTab('history')\">📜 Histórico</button></nav><section class=\"p64ArenaBody\">${body}</section></div>`}\narenaHtml=function(){return (typeof NerdoraChibiBridge!=='undefined'&&NerdoraChibiBridge?.connected)?p64ArenaOnline():p64ArenaOffline()};\nrenderModes=function(){if(!['core','trials','arena','events','shops','endgame'].includes(UI.modeTab))UI.modeTab='core';const content=UI.modeTab==='core'?p64CoreModes():UI.modeTab==='arena'?arenaHtml():p64LegacyPanel(UI.modeTab);$('#screen').innerHTML=`${title('Salão de Batalha','Escolha seu próximo desafio')}<div class=\"p64ModesShell\">${p64ModeTabs()}<section class=\"p64ModeBody\">${content}</section></div>`;if(window.NerdoraUI?.enhance)setTimeout(()=>NerdoraUI.enhance(),0)};\nUI.p64Mode=function(tab){UI.modeTab=tab;P64.modeTab=tab;renderModes()};\nUI.p64ArenaTab=function(tab){P64.arenaTab=tab;renderModes()};\n\nGame.p64TowerWindow=function(){const f=state.phase56?.towerFloor||1,r=p56RecommendedPower('tower');NerdoraUI.openWindow('Torre Eterna',`<div class=\"p64ChallengeWindow tower\"><div class=\"p64ChallengeIcon\">♜</div><div class=\"p64ChallengeIntro\"><small>DESAFIO ASCENDENTE</small><h2>Andar ${f}</h2><p>Inimigos ficam mais fortes a cada andar. A Torre é uma das principais fontes de Runas.</p></div><div class=\"p64ChallengeStats\"><span><small>PODER RECOMENDADO</small><b>⚔ ${fmt(r)}</b></span><span><small>TENTATIVAS</small><b>${state.phase56?.towerTries??5}/5</b></span><span><small>RECORDE</small><b>${state.phase56?.towerBest||0}</b></span></div><div class=\"p64ChallengeActions\"><button onclick=\"NerdoraUI.closeWindow();Game.startTower()\">DESAFIAR ANDAR</button><button onclick=\"NerdoraUI.closeWindow();UI.nav('formation')\">AJUSTAR FORMAÇÃO</button></div></div>`)};\nGame.p64BossWindow=function(){const angel=typeof P57_ANGELS!=='undefined'?P57_ANGELS[state.angels?.active]:null;NerdoraUI.openWindow('Chefe Épico · Colosso do Vazio',`<div class=\"p64ChallengeWindow boss\"><div class=\"p64BossCrest\"><span>🐉</span><i></i></div><div class=\"p64ChallengeIntro\"><small>CHEFE DIÁRIO · LOOT AVANÇADO</small><h2>Colosso do Vazio</h2><p>Três waves e uma luta final de alta resistência. Use seu melhor preset de Boss.</p></div><div class=\"p64ChallengeStats\"><span><small>PODER DA EQUIPE</small><b>⚔ ${fmt(teamPower())}</b></span><span><small>TENTATIVAS</small><b>${state.phase56?.bossTries??3}/3</b></span><span><small>MELHOR MARCA</small><b>${fmt(state.phase56?.bossBest||0)}</b></span><span><small>ANGEL</small><b>${angel?esc(angel.name):'Nenhum'}</b></span></div><div class=\"p64BossRewards\"><b>RECOMPENSAS POSSÍVEIS</b><div><span>◇ Runas</span><span>♜ Emblemas</span><span>🪙 Ouro</span><span>SSR Chance</span></div></div><div class=\"p64ChallengeActions\"><button onclick=\"NerdoraUI.closeWindow();Game.startBoss()\" ${(state.phase56?.bossTries??3)<=0?'disabled':''}>⚔ DESAFIAR BOSS</button><button onclick=\"NerdoraUI.closeWindow();UI.nav('formation')\">🛡 PREPARAR EQUIPE</button></div></div>`)};\n\n// Mantém o resultado online dentro da linguagem visual da 6.UI.4.\nconst p64FinishBase=Battle.finish.bind(Battle);\nBattle.finish=function(win){const online=!!this.ctx?.onlineArena;const boss=this.ctx?.mode==='boss';const r=p64FinishBase(win);if(online||boss)setTimeout(()=>{const card=document.querySelector('#battleResult .resultCard');if(card)card.classList.add('p64ResultCard')},0);return r};\n\nsave();\n})();\n\n\n// ===== FASE 6.UI.5 · INVENTÁRIO / EQUIPAMENTOS / RUNAS / EMBLEMAS / ARTEFATOS / RELÍQUIAS =====\n(()=>{\n'use strict';\nstate.version='10.4.0-phase6.ui.5';\ntry{document.title='Nerdora Chibi Raiders — FASE 6.UI.5'}catch(e){}\np542Ensure();p59Ensure();\nUI.p65InvTab=UI.p65InvTab||'equipment';\nconst P65_TABS=[\n ['equipment','⚔','Equipamentos'],['materials','◆','Materiais'],['runes','◇','Runas'],['emblems','♜','Emblemas'],['artifacts','🧿','Artefatos'],['relics','🏺','Relíquias']\n];\nfunction p65Esc(v){return String(v??'').replace(/[&<>\\\"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\"'\":'&#39;'}[m]))}\nfunction p65OwnedFirst(){return state.phase541?.compareHero||ownedHeroes()[0]?.id||''}\nfunction p65EquipCounts(){return {loose:Object.values(state.equipmentInventory||{}).reduce((a,b)=>a+(Number(b)||0),0),equipped:p541EquippedCopies().length}}\nfunction p65RuneLoose(){return Object.values(state.phase542?.runeInventory||{}).reduce((a,b)=>a+(Number(b)||0),0)}\nfunction p65EmblemLoose(){return Object.values(state.phase542?.emblemInventory||{}).reduce((a,b)=>a+(Number(b)||0),0)}\nfunction p65MaterialCount(){return Object.values(state.resources||{}).filter(v=>Number(v)>0).length}\nfunction p65Nav(){const ec=p65EquipCounts();const counts={equipment:ec.loose,runes:p65RuneLoose(),emblems:p65EmblemLoose(),artifacts:D.phase4.artifacts.length,relics:D.phase4.relics.length,materials:p65MaterialCount()};return `<nav class=\"p65Rail\">${P65_TABS.map(([k,ico,n])=>`<button class=\"${UI.p65InvTab===k?'active':''}\" onclick=\"UI.p65SetTab('${k}')\"><span>${ico}</span><b>${n}</b><small>${counts[k]||0}</small></button>`).join('')}</nav>`}\nUI.p65SetTab=function(tab){if(!P65_TABS.some(x=>x[0]===tab))return;this.p65InvTab=tab;renderInventory()};\n\nfunction p65HeroPicker(tab='gear',titleText='Escolha um herói'){\n const list=ownedHeroes();\n NerdoraUI.openWindow(titleText,`<div class=\"p65HeroPicker\">${list.map(b=>{const h=heroState(b.id),src=PHASE5_HERO_ASSETS?.[b.id];return `<button onclick=\"NerdoraUI.closeWindow();UI.openHero('${b.id}','${tab}')\"><span class=\"p65PickerArt\">${src?`<img src=\"${src}\" alt=\"${p65Esc(b.name)}\">`:b.emoji}</span><span><b>${p65Esc(b.name)}</b><small>${b.rarity} · Lv.${h.level} · ⚔ ${fmt(heroPower(b.id))}</small></span><em>ABRIR</em></button>`}).join('')}</div>`)\n}\nGame.p65HeroPicker=p65HeroPicker;\n\nfunction p65EquipmentPane(){\n const f=state.phase541.filters,view=state.phase541.view,owner=state.phase541.owner,compareHero=state.phase541.compareHero||p65OwnedFirst();\n if(!state.phase541.compareHero&&compareHero)state.phase541.compareHero=compareHero;\n const looseRows=D.equipment.items.filter(d=>(state.equipmentInventory[d.id]||0)>0).map(d=>({kind:'loose',itemId:d.id,count:state.equipmentInventory[d.id]||0,enhance:p541StoredMax(d.id)}));\n const eqRows=p541EquippedCopies().filter(x=>owner==='ALL'||x.heroId===owner).map(x=>({kind:'equipped',...x,count:1}));\n let rows=view==='loose'?looseRows:view==='equipped'?eqRows:[...looseRows,...eqRows];\n rows=rows.filter(r=>{const d=equipmentDef(r.itemId);return d&&(f.rarity==='ALL'||d.rarity===f.rarity)&&(f.slot==='ALL'||d.slot===f.slot)&&(f.set==='ALL'||d.set===f.set)});p541SortRows(rows);\n const c=p65EquipCounts(),compareName=heroBase(compareHero)?.name||'—';\n return `<section class=\"p65Pane p65EquipmentPane\"><header class=\"p65PaneHero\"><div><small>ARSENAL DA CONTA</small><h2>Equipamentos</h2><p>Seis slots por herói, atributos secundários, comparação de Poder e conjuntos 2/4/6.</p></div><div class=\"p65PaneStats\"><span><b>${c.loose}</b><small>soltos</small></span><span><b>${c.equipped}</b><small>equipados</small></span><span><b>${compareName}</b><small>comparação</small></span></div><div class=\"p65HeroActions\"><button onclick=\"Game.autoEquipTeam()\">⚙ AUTO EQUIP EQUIPE</button><button onclick=\"Game.p65HeroPicker('gear','Equipamentos · escolher herói')\">HERÓIS</button></div></header>\n <div class=\"p65EquipWorkspace\"><main class=\"p65InventoryMain\"><div class=\"p65Toolbar\"><div class=\"p541ViewTabs\">${p541ViewBtn('loose','Disponíveis')}${p541ViewBtn('equipped','Equipados')}${p541ViewBtn('all','Todos')}</div>${p541Select('sort',[['improvement','Melhoria'],['rarity','Raridade'],['enhance','Aprimoramento'],['slot','Slot'],['set','Conjunto'],['name','Nome']])}${p541Select('compareHero',ownedHeroes().map(b=>[b.id,b.name]))}</div><div class=\"p65Chips\">${['ALL','R','EP','SR','SSR'].map(x=>p541FilterBtn('rarity',x,x==='ALL'?'Todas':x)).join('')}<select onchange=\"UI.p541Filter('slot',this.value)\"><option value=\"ALL\">Todos os slots</option>${D.equipment.slots.map(sl=>`<option value=\"${sl}\" ${f.slot===sl?'selected':''}>${P541_SLOT_NAME[sl]}</option>`).join('')}</select><select onchange=\"UI.p541Filter('set',this.value)\"><option value=\"ALL\">Todos os conjuntos</option>${Object.keys(P541_SETS).map(set=>`<option value=\"${set}\" ${f.set===set?'selected':''}>${set}</option>`).join('')}</select></div><div class=\"p65EquipGrid ui61InnerScroll\">${rows.length?rows.map(r=>r.kind==='equipped'?p541EquippedCard(r):p541LooseCard(r)).join(''):'<div class=\"p65Empty\">Nenhum equipamento corresponde aos filtros.</div>'}</div></main>\n <aside class=\"p65EquipSide\"><section><div class=\"p65SectionHead\"><b>HERÓI EM FOCO</b><button onclick=\"Game.p65HeroPicker('gear')\">TROCAR</button></div>${p541EquippedHeroPanel()}</section><section class=\"p65SetsMini\"><div class=\"p65SectionHead\"><b>CONJUNTOS</b><button onclick=\"Game.showGetPath('equipment','${compareHero}')\">DROPS</button></div><div class=\"p65SetScroll ui61InnerScroll\">${Object.entries(P541_SETS).map(([n,d])=>`<article style=\"--set:${d.color}\"><span>${d.icon}</span><div><b>${n}</b><small>${d.role}</small><p><strong>2</strong> ${p541BonusText(d.tiers[2])}<br><strong>4</strong> ${p541BonusText(d.tiers[4])}<br><strong>6</strong> ${p541BonusText(d.tiers[6])}</p></div></article>`).join('')}</div></section></aside></div></section>`\n}\n\nconst P65_MATERIALS=[\n ['✨','Essência de Herói','hero_exp','Heróis'],['🔷','Essência de Qualidade','quality_essence','Heróis'],['📘','Livro de Skill','skill_book','Habilidades'],['🪨','Pedra de Treino','train_stone','Treino'],\n ['🌀','Pedra Rúnica','rune_stone','Runas'],['🎖️','Fragmento de Emblema','emblem_shard','Emblemas'],['🌟','Essência de Despertar','awaken_essence','Despertar'],['🔺','Pedra de Ruptura','breakthrough_stone','Ruptura'],\n ['🧩','Fragmento Universal','universal_fragments','Estrelas'],['🧿','Núcleo de Artefato','artifact_core','Artefatos'],['🏺','Pó de Relíquia','relic_dust','Relíquias'],['💎','Cristal de Relíquia','relic_crystal','Relíquias'],\n ['♻️','Núcleo Renascente','rebirth_core','Renascimento'],['✦','Pó Estelar','star_dust','Constelação'],['☀️','Essência Divina','divinity_essence','Divindade'],['📖','Página de Crônica','chronicle_page','Crônicas'],\n ['🎫','Ticket de Sweep','sweep_ticket','Campanha'],['👼','Essência Angelical','angel_essence','Angels'],['💠','Pedra de Rank Angelical','angel_rank_stone','Angels'],['⭕','Cristal de Halo','halo_crystal','Angels']\n];\nfunction p65MaterialsPane(){return `<section class=\"p65Pane\"><header class=\"p65PaneHero material\"><div><small>RECURSOS DE PROGRESSÃO</small><h2>Materiais</h2><p>Todos os recursos importantes reunidos em uma única coleção. Esta área é a única que rola.</p></div><div class=\"p65PaneStats\"><span><b>${P65_MATERIALS.filter(x=>(state.resources[x[2]]||0)>0).length}</b><small>tipos possuídos</small></span><span><b>${fmt(state.player.gold)}</b><small>ouro</small></span><span><b>${fmt(state.player.gems)}</b><small>gemas</small></span></div></header><div class=\"p65MaterialGrid ui61InnerScroll\">${P65_MATERIALS.map(([ico,n,k,use])=>`<article><span>${ico}</span><div><small>${use}</small><b>${n}</b><strong>${fmt(state.resources[k]||0)}</strong></div></article>`).join('')}</div></section>`}\n\nfunction p65RunePane(){p542Ensure();const items=P542_RUNES.filter(r=>(state.phase542.runeInventory[r.id]||0)>0);return `<section class=\"p65Pane\"><header class=\"p65PaneHero rune\"><div><small>GRIMÓRIO RÚNICO</small><h2>Runas</h2><p>Cinco posições por herói. Conjuntos 2/4/5 mudam a função da build e entram no combate real.</p></div><div class=\"p65PaneStats\"><span><b>${p65RuneLoose()}</b><small>runas soltas</small></span><span><b>${fmt(state.resources.rune_stone||0)}</b><small>pedras</small></span><span><b>${fmt(state.phase542.forgeDust||0)}</b><small>pó de forja</small></span></div><div class=\"p65HeroActions\"><button onclick=\"Game.p65HeroPicker('runes','Runas · escolher herói')\">GERENCIAR HERÓI</button><button onclick=\"Game.openForge()\">⚒ FORJA</button></div></header><div class=\"p65RuneWorkspace\"><aside class=\"p65SetRail\">${Object.entries(P542_RUNE_SETS).map(([k,d])=>{const count=items.filter(x=>x.set===k).reduce((n,x)=>n+(state.phase542.runeInventory[x.id]||0),0);return `<article style=\"--set:${d.color}\"><span>${d.icon}</span><div><b>${d.name}</b><small>${d.role}</small><p>2/4/5 peças · ${count} no inventário</p></div></article>`}).join('')}</aside><main class=\"p65RuneGrid ui61InnerScroll\">${items.length?items.map(d=>`<article style=\"--piece:${P542_RUNE_SETS[d.set].color}\"><span>${d.icon}</span><div><small>${d.rarity} · ${P542_RUNE_SLOT_NAMES[d.slot]}</small><b>${d.name}</b><p>${p542StatText(p542RuneStats({id:d.id,level:0}))}</p></div><strong>x${state.phase542.runeInventory[d.id]||0}</strong></article>`).join(''):'<div class=\"p65Empty\">Nenhuma runa solta. Obtenha runas na Torre, Boss e Forja.</div>'}</main></div></section>`}\n\nfunction p65EmblemPane(){p542Ensure();const items=P542_EMBLEMS.filter(r=>(state.phase542.emblemInventory[r.id]||0)>0);return `<section class=\"p65Pane\"><header class=\"p65PaneHero emblem\"><div><small>HERÁLDICA DE BATALHA</small><h2>Emblemas</h2><p>Quatro posições por herói, progressão individual e bônus de conjunto 2/4.</p></div><div class=\"p65PaneStats\"><span><b>${p65EmblemLoose()}</b><small>emblemas soltos</small></span><span><b>${fmt(state.resources.emblem_shard||0)}</b><small>fragmentos</small></s