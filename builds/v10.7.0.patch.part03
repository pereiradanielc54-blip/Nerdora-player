ton class=\"ownedToggle ${UI.heroOwned==='owned'?'active':''}\" onclick=\"UI.setOwnedFilter('${UI.heroOwned==='owned'?'all':'owned'}')\">${UI.heroOwned==='owned'?'✓ Só obtidos':'Filtrar obtidos'}</button></div><div class=\"heroesMain\"><section class=\"rosterPanel\"><div class=\"rosterPanelHead\"><b>Coleção</b><span>${list.length} heróis · role apenas esta área</span></div><div class=\"rosterScroll\"><div class=\"heroCollectionGrid\">${list.length?list.map(h=>heroCollectionCard(h,h.id===UI.selectedHero)).join(''):'<div class=\"emptyRoster\">Nenhum herói corresponde a este filtro.</div>'}</div></div></section>${selected?heroFocusHtml(selected):'<section class=\"heroFocusPanel\"><div class=\"emptyRoster\">Nenhum herói disponível.</div></section>'}</div></section>`;\n};\n\n// Deixa a ficha como uma janela de comando premium, sem textos técnicos de versão.\nconst p63HeroDetailBase=heroDetailHtml;\nheroDetailHtml=function(id,tab){\n let out=p63HeroDetailBase(id,tab);\n out=out.replace('class=\"p52HeroDetail ','class=\"p52HeroDetail p63HeroDetail ')\n        .replace(/FASE 5\\.9 · LEGADOS E CRÔNICAS/g,'CENTRAL DO HERÓI')\n        .replace(/FASE 5\\.8 · ENDGAME DO HERÓI/g,'CENTRAL DO HERÓI');\n return out;\n};\n\n// --- FORMAÇÃO: campo fixo; escolha de herói em janela interna ---\nfunction p63FormationSlot(slot){\n const id=state.formation[slot],line=slot[0]==='F'?'front':'back';\n if(!id)return `<button class=\"p63FieldSlot empty ${line}\" onclick=\"Game.p63OpenFormationPicker('${slot}')\"><span class=\"p63SlotTag\">${slot}</span><span class=\"p63EmptyPlus\">＋</span><b>${line==='front'?'Linha da Frente':'Retaguarda'}</b><small>Toque para escolher</small></button>`;\n const b=heroBase(id),h=heroState(id),k=p525Kit(id),src=PHASE5_HERO_ASSETS?.[id],bo=p53PositionBonus(id,line);\n return `<button class=\"p63FieldSlot ${line}\" onclick=\"Game.p63OpenFormationPicker('${slot}')\"><span class=\"p63SlotTag\">${slot}</span><span class=\"p63PositionBuff\">${bo.label.split('·')[0]}</span><span class=\"p63FieldArt\">${src?`<img src=\"${src}\" alt=\"${b.name}\">`:`${b.emoji}`}</span><span class=\"p63FieldCopy\"><b>${b.name}</b><small>${k?.element||'—'} · ${k?.faction||'—'} · ${h.stars}★</small><strong>⚔ ${fmt(p53EffectiveHeroPower(id,slot,state.formation))}</strong></span></button>`;\n}\nfunction p63FormationOverview(){\n const p=p53Profile(state.formation),warnings=p53Warnings(state.formation),active=p53AllSynergies(state.formation,false).filter(x=>x.active),ids=Object.values(state.formation).filter(Boolean);\n return `<section class=\"p63FormationSide\"><div class=\"p63SideHead\"><small>LEITURA TÁTICA</small><b>Equipe ${ids.length}/5</b><strong>⚔ ${fmt(p53FormationPower())}</strong></div><div class=\"p63RoleStrip\"><span>🛡 <b>${p.tank}</b><small>Tank</small></span><span>❤ <b>${p.heal}</b><small>Cura</small></span><span>❄ <b>${p.control}</b><small>Controle</small></span><span>⚡ <b>${p.burst}</b><small>Burst</small></span></div><div class=\"p63Warnings\">${warnings.slice(0,3).map(w=>`<span class=\"${w.c||''}\">${w.t}</span>`).join('')}</div><div class=\"p63SynPreview\"><div><b>✦ Sinergias</b><small>${active.length} ativa${active.length===1?'':'s'}</small></div>${active.slice(0,3).map(s=>`<span><b>${s.name}</b><small>${s.copy}</small></span>`).join('')||'<em>Nenhuma sinergia ativa.</em>'}<button onclick=\"Game.p63OpenSynergies()\">Ver detalhes</button></div></section>`;\n}\nfunction p63FormationPickerHtml(slot){\n const roster=ownedHeroes().sort((a,b)=>heroPower(b.id)-heroPower(a.id)),candidate=P63.formationCandidate;\n let compare='';\n if(candidate){const d=p53CompareData(slot,candidate),delta=d.ap-d.bp,b=heroBase(candidate),k=p525Kit(candidate);compare=`<div class=\"p63PickerCompare\"><div><small>TROCA PROPOSTA · ${slot}</small><b>${b.name}</b><span>${k?.element||'—'} · ${k?.faction||'—'}</span></div><div><small>PODER EFETIVO</small><b>${fmt(d.bp)} → ${fmt(d.ap)}</b><strong class=\"${delta>=0?'up':'down'}\">${delta>=0?'+':''}${fmt(delta)}</strong></div><button onclick=\"Game.p63ConfirmFormation('${slot}','${candidate}')\">CONFIRMAR</button></div>`}\n return `<div class=\"p63Picker\">${compare}<div class=\"p63PickerHint\">Escolha um herói. A lista abaixo é a única área rolável desta janela.</div><div class=\"p63PickerGrid\">${roster.map(h=>{const b=heroBase(h.id),k=p525Kit(h.id),src=PHASE5_HERO_ASSETS?.[h.id],used=Object.values(state.formation).includes(h.id);return `<button class=\"p63PickHero ${candidate===h.id?'selected':''} ${used?'used':''}\" onclick=\"Game.p63SelectFormationCandidate('${slot}','${h.id}')\"><span>${src?`<img src=\"${src}\" alt=\"${b.name}\">`:b.emoji}</span><b>${b.name}</b><small>${k?.tactical||b.role}</small><em>${k?.element||'—'} · ${b.rarity}</em><strong>⚔ ${fmt(heroPower(h.id))}</strong></button>`}).join('')}</div><div class=\"p63PickerFooter\"><button class=\"danger\" onclick=\"Game.p63RemoveFormation('${slot}')\">Remover do slot</button><button onclick=\"NerdoraUI.closeWindow()\">Cancelar</button></div></div>`;\n}\nGame.p63OpenFormationPicker=function(slot){P63.formationSlot=slot;P63.formationCandidate=null;NerdoraUI.openWindow(`Formação · ${slot}`,p63FormationPickerHtml(slot));};\nGame.p63SelectFormationCandidate=function(slot,id){P63.formationCandidate=id;NerdoraUI.openWindow(`Formação · ${slot}`,p63FormationPickerHtml(slot));};\nGame.p63ConfirmFormation=function(slot,id){state.formation=p53ApplyCandidate(state.formation,slot,id);p53SavePreset();P63.formationCandidate=null;P63.formationSlot=null;save();NerdoraUI.closeWindow();renderFormation();toast('Formação atualizada');};\nGame.p63RemoveFormation=function(slot){state.formation[slot]=null;p53SavePreset();save();NerdoraUI.closeWindow();renderFormation();toast('Slot liberado');};\nGame.p63OpenSynergies=function(){const rows=p53AllSynergies(state.formation,true);NerdoraUI.openWindow('Sinergias da formação',`<div class=\"p63SynWindow\">${rows.map(s=>`<article class=\"${s.active?'active':''}\"><div><b>${s.active?'✓':'◇'} ${s.name}</b><strong>${s.type==='special'?`${s.count}/${s.need}`:`${s.count}/5`}</strong></div><p>${s.copy}</p><small>Recebem: ${s.recipients.map(id=>heroBase(id)?.name).filter(Boolean).join(', ')||'—'}</small></article>`).join('')||'<p class=\"muted\">Monte afinidades para ativar bônus.</p>'}</div>`);};\n\nrenderFormation=function(){\n p53EnsureState();p57Ensure();const preset=state.phase53.activePreset,id=state.angels.active,a=P57_ANGELS[id],as=p57AngelState(id),src=a?.asset;\n $('#screen').innerHTML=`${title('Formação','5 Heróis + 1 Angel · toque em qualquer posição para editar',`<span class=\"tag\">⚔ ${fmt(p53FormationPower())}</span>`)}<div class=\"p63FormationPage\"><div class=\"p63PresetBar\">${Object.entries(P53_PRESETS).map(([k,v])=>`<button class=\"${preset===k?'active':''}\" onclick=\"UI.p53SwitchPreset('${k}')\">${v.icon}<span>${v.name}</span></button>`).join('')}<button class=\"auto\" onclick=\"UI.p53AutoForm()\">⚙<span>Autoformar</span></button></div><div class=\"p63FormationMain\"><section class=\"p63BattleCard\"><div class=\"p63BattleHead\"><div><small>CAMPO DE BATALHA</small><b>Posicionamento tático</b></div><span>Front-line protege a retaguarda</span></div><div class=\"p63Battlefield\"><div class=\"p63Line back\"><label>BACK-LINE</label>${['B1','B2','B3'].map(p63FormationSlot).join('')}</div><div class=\"p63Line front\"><label>FRONT-LINE</label>${['F1','F2'].map(p63FormationSlot).join('')}</div><div class=\"p63FieldDivider\"></div></div><div class=\"p63AngelSupport\" style=\"--angel:${a?.color||'#8f72ff'}\"><span class=\"p63AngelMini\">${src?`<img src=\"${src}\" alt=\"${a.name}\">`:'👼'}</span><span><small>SUPORTE ANGELICAL</small><b>${a?.name||'Angel'}</b><em>${a?.element||''} · Halo Lv.${as?.haloLevel||0}</em></span><button onclick=\"UI.nav('angels')\">Trocar</button></div></section>${p63FormationOverview()}</div></div>`;\n};\n\n// --- ANGELS: vitrine fixa; progressão e kit em janelas dedicadas ---\nfunction p63AngelRosterCard(id){const a=P57_ANGELS[id],s=p57AngelState(id),active=state.angels.active===id,sel=(UI.selectedAngel||state.angels.active)===id;return `<button class=\"p63AngelCard ${active?'active':''} ${sel?'selected':''}\" style=\"--angel:${a.color}\" onclick=\"UI.p57SelectAngel('${id}')\"><span class=\"p63AngelThumb\"><img src=\"${a.asset}\" alt=\"${a.name}\"></span><span class=\"p63AngelCardCopy\"><b>${a.name}</b><small>${a.element} · ${a.role}</small><em>${'★'.repeat(s.stars)}${'☆'.repeat(6-s.stars)}</em></span>${active?'<i>ATIVO</i>':''}</button>`}\nfunction p63AngelMain(id){const a=P57_ANGELS[id],s=p57AngelState(id),active=state.angels.active===id;return `<section class=\"p63AngelHero\" style=\"--angel:${a.color}\"><div class=\"p63AngelBackdrop\"></div><div class=\"p63AngelArt\"><img src=\"${a.asset}\" alt=\"${a.name}\"></div><div class=\"p63AngelIdentity\"><small>${a.element.toUpperCase()} · ${a.role.toUpperCase()}</small><h2>${a.name}</h2><div class=\"p63AngelStars\">${'★'.repeat(s.stars)}${'☆'.repeat(6-s.stars)}</div><div class=\"p63AngelMetrics\"><span><small>PODER</small><b>⚔ ${fmt(p57AngelPower(id))}</b></span><span><small>RANK</small><b>${s.rank}/10</b></span><span><small>HALO</small><b>Lv.${s.haloLevel}</b></span></div><p>${a.ultimateDesc}</p><div class=\"p63AngelActions\"><button class=\"${active?'active':''}\" onclick=\"Game.p57ActivateAngel('${id}')\">${active?'✓ Angel ativo':'Usar como Angel ativo'}</button><button onclick=\"Game.p63AngelProgress('${id}')\">⬆ Evolução</button><button onclick=\"Game.p63AngelKit('${id}')\">✦ Kit & Halo</button></div></div></section>`}\nrenderAngels=function(){p57Ensure();const id=UI.selectedAngel||state.angels.active;$('#screen').innerHTML=`${title('Anjos','Escolha o suporte celestial da formação',p57AngelResources())}<div class=\"p63AngelsPage\"><section class=\"p63AngelRoster\"><div class=\"p63AngelRosterHead\"><div><small>CÍRCULO CELESTIAL</small><b>6 Angels</b></div><span>Role apenas a coleção</span></div><div class=\"p63AngelRosterScroll\">${Object.keys(P57_ANGELS).map(p63AngelRosterCard).join('')}</div></section>${p63AngelMain(id)}<aside class=\"p63AngelSummary\" style=\"--angel:${P57_ANGELS[id].color}\"><div><small>ULTIMATE ANGELICAL</small><b>${P57_ANGELS[id].ultimate}</b><p>${P57_ANGELS[id].ultimateDesc}</p></div><div><small>HALO ATUAL</small><b>${P57_ANGELS[id].halo}</b><p>${p57HaloText(id)}</p></div><button onclick=\"Game.p63AngelProgress('${id}')\">Abrir evolução</button><button onclick=\"Game.p63GoAngelTrial()\">Provação Celestial</button></aside></div>`;};\nGame.p63AngelProgress=function(id){const a=P57_ANGELS[id],s=p57AngelState(id),lc=p57AngelLevelCost(s),rc=p57AngelRankCost(s),sc=p57AngelSkillCost(s),hc=p57AngelHaloCost(s),star=p57StarCost(s.stars);NerdoraUI.openWindow(`${a.name} · Evolução`, `<div class=\"p63AngelProgressWin\"><div class=\"p63AngelProgressHero\"><img src=\"${a.asset}\" alt=\"${a.name}\"><span><small>${a.element} · ${a.role}</small><b>${a.name}</b><em>⚔ ${fmt(p57AngelPower(id))}</em></span></div><div class=\"p63ProgressGrid\"><article><span>◈</span><div><small>NÍVEL</small><b>${s.level}/100</b><p>✨ ${lc.ess} · 🪙 ${fmt(lc.gold)}</p></div><button onclick=\"Game.p63AngelUpgrade('${id}','level')\" ${s.level>=100?'disabled':''}>Melhorar</button></article><article><span>★</span><div><small>ESTRELAS</small><b>${s.stars}/6</b><p>🧩 ${s.fragments}/${star}</p></div><button onclick=\"Game.p63AngelUpgrade('${id}','star')\" ${s.stars>=6?'disabled':''}>Evoluir</button></article><article><span>◇</span><div><small>RANK</small><b>${s.rank}/10</b><p>🔷 ${rc.stone} · 🪙 ${fmt(rc.gold)}</p></div><button onclick=\"Game.p63AngelUpgrade('${id}','rank')\" ${s.rank>=10?'disabled':''}>Avançar</button></article><article><span>✦</span><div><small>HABILIDADE</small><b>Lv.${s.skillLevel}/20</b><p>✨ ${sc.ess} · 🪙 ${fmt(sc.gold)}</p></div><button onclick=\"Game.p63AngelUpgrade('${id}','skill')\" ${s.skillLevel>=20?'disabled':''}>Melhorar</button></article><article><span>◎</span><div><small>HALO</small><b>Lv.${s.haloLevel}/10</b><p>💠 ${hc.crystal} · 🪙 ${fmt(hc.gold)}</p></div><button onclick=\"Game.p63AngelUpgrade('${id}','halo')\" ${s.haloLevel>=10?'disabled':''}>Fortalecer</button></article></div></div>`);};\nconst p63AngelUpgradeBase=Game.p57AngelUpgrade.bind(Game);\nGame.p63AngelUpgrade=function(id,type){p63AngelUpgradeBase(id,type);setTimeout(()=>Game.p63AngelProgress(id),40)};\nGame.p63AngelKit=function(id){const a=P57_ANGELS[id],s=p57AngelState(id);NerdoraUI.openWindow(`${a.name} · Kit & Halo`,`<div class=\"p63AngelKitWin\"><div class=\"p63KitHero\"><img src=\"${a.asset}\" alt=\"${a.name}\"><div><small>${a.element} · ${a.role}</small><h3>${a.name}</h3><p>Rank ${s.rank} · ${s.stars}★ · Halo Lv.${s.haloLevel}</p></div></div><article><span>✦</span><div><small>ULTIMATE</small><b>${a.ultimate}</b><p>${a.ultimateDesc}</p></div></article><article><span>◎</span><div><small>HALO</small><b>${a.halo}</b><p>${a.haloDesc}</p><strong>${p57HaloText(id)}</strong></div></article><article><span>⚡</span><div><small>ENERGIA ANGELICAL</small><b>Carrega uma vez por rodada</b><p>A Ultimate fica disponível ao alcançar 1000 de Energia Angelical.</p></div></article></div>`);};\nGame.p63GoAngelTrial=function(){UI.route='modes';UI.modeTab='trials';render()};\n\n// Atualiza textos técnicos que ainda apareceriam na interface de evolução.\nconst p63TitleBase=title;\ntitle=function(t,sub='',actions=''){return p63TitleBase(t,String(sub).replace(/FASE\\s*[0-9.]+\\s*·?\\s*/gi,''),actions)};\n\ntry{document.title='Nerdora Chibi Raiders — FASE 6.UI.3'}catch(e){}\n\n// ===== FASE 6.UI.4 INJETADA NO MOTOR PRINCIPAL =====\n(()=>{\n'use strict';\nstate.version='10.3.0-phase6.ui.4';\ntry{document.title='Nerdora Chibi Raiders — FASE 6.UI.4'}catch(e){}\nconst P64={campaignChapter:1,campaignStage:null,arenaTab:'rivals',modeTab:UI.modeTab||'core'};\nwindow.P64=P64;\nconst esc=v=>String(v??'').replace(/[&<>\\\"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\"'\":'&#39;'}[m]));\nconst chapterNames=['Bosque de Nébula','Árvore Celeste','Reino Esquecido'];\nconst chapterIcons=['✦','♜','◆'];\nconst chapterCopy=['Névoa viva e criaturas corrompidas guardam a primeira rota.','Suba pelas raízes da Árvore Celeste e rompa as defesas antigas.','Atravesse ruínas esquecidas até o coração do reino caído.'];\nfunction p64Map(){return UI.campaignMode==='elite'?state.campaign.eliteCompleted:state.campaign.completed}\nfunction p64StageList(ch=P64.campaignChapter){return (UI.campaignMode==='elite'?D.eliteStages:D.stages).filter(s=>s.chapter===ch)}\nfunction p64ChapterStars(ch){const map=p64Map();return p64StageList(ch).reduce((a,s)=>a+(map[s.id]?.stars||0),0)}\nfunction p64StageSelected(){const list=p64StageList();let s=list.find(x=>x.id===P64.campaignStage);if(!s)s=list.find(x=>stageUnlocked(x)&&!p64Map()[x.id])||[...list].reverse().find(x=>p64Map()[x.id])||list[0];if(s)P64.campaignStage=s.id;return s}\nfunction p64Rewards(s){const r=s?.rewards||{};return [['🪙',fmt(r.gold||0),'Ouro'],['✨',fmt(r.heroXp||0),'EXP'],['🔷',fmt(r.qualityEssence||0),'Qualidade'],['🌀',fmt(r.runeStone||0),'Runas']].filter(x=>x[1]!=='0')}\nfunction p64StageDetail(s){if(!s)return '<div class=\"p64Empty\">Nenhuma fase disponível.</div>';const done=p64Map()[s.id],un=stageUnlocked(s),waves=s.elite||s.boss?3:2;const rw=p64Rewards(s);return `<section class=\"p64StageDetail ${s.boss?'boss':''}\"><div class=\"p64DetailKicker\">${s.boss?'CHEFE DO CAPÍTULO':UI.campaignMode==='elite'?'ROTA ELITE':'ROTA PRINCIPAL'}</div><h2>${esc(s.name)}</h2><div class=\"p64StageMeta\"><span>⚡ ${s.energy} energia</span><span>🌊 ${waves} waves</span><span>⚔ x${Number(s.enemyScale||1).toFixed(2)}</span></div><div class=\"p64StarsBig\">${done?'★'.repeat(done.stars)+'☆'.repeat(3-done.stars):'☆☆☆'}</div><div class=\"p64RewardGrid\">${rw.map(([i,v,n])=>`<div><span>${i}</span><b>${v}</b><small>${n}</small></div>`).join('')}</div><div class=\"p64StageActions\">${un?`<button class=\"p64Primary\" onclick=\"Game.startStage('${s.id}',${!!s.elite})\">⚔ INICIAR BATALHA</button>`:`<button disabled>🔒 CONCLUA A FASE ANTERIOR</button>`}${done?.stars>=3?`<button class=\"p64Secondary\" onclick=\"Game.sweepStage('${s.id}',${!!s.elite})\">⚡ SWEEP · 1 🎫</button>`:''}</div></section>`}\nfunction p64ChapterRewardBar(ch){const stars=p64ChapterStars(ch);return `<div class=\"p64ChapterRewards\"><div><small>RECOMPENSA DO CAPÍTULO</small><b>⭐ ${stars}/15</b></div><div class=\"p64ChestTrack\">${D.balance.chapterStarThresholds.map(t=>{const key=`${UI.campaignMode==='elite'?'E':'N'}${ch}_${t}`,claimed=state.campaign.chapterRewards[key],ok=stars>=t;return `<button class=\"${claimed?'claimed':ok?'ready':''}\" onclick=\"Game.claimChapterReward(${ch},${t},${UI.campaignMode==='elite'})\" ${!ok||claimed?'disabled':''}><span>${claimed?'✓':'🎁'}</span><small>${t}★</small></button>`}).join('')}</div></div>`}\nrenderCampaign=function(){const list=p64StageList();if(!list.length){P64.campaignChapter=1;P64.campaignStage=null}const selected=p64StageSelected();$('#screen').innerHTML=`${title('Campanha','Jornada principal de Nerdora',`<div class=\"p64CampaignToggle\"><button class=\"${UI.campaignMode!=='elite'?'active':''}\" onclick=\"UI.p64CampaignMode(false)\">NORMAL</button><button class=\"${UI.campaignMode==='elite'?'active':''}\" onclick=\"UI.p64CampaignMode(true)\" ${!isUnlocked('elite')?'disabled':''}>ELITE</button></div>`)}<div class=\"p64CampaignShell\"><aside class=\"p64ChapterRail\"><div class=\"p64RailLabel\">CAPÍTULOS</div>${[1,2,3].map(ch=>`<button class=\"${P64.campaignChapter===ch?'active':''}\" onclick=\"UI.p64CampaignChapter(${ch})\"><i>${chapterIcons[ch-1]}</i><span><small>CAPÍTULO ${String(ch).padStart(2,'0')}</small><b>${chapterNames[ch-1]}</b><em>⭐ ${p64ChapterStars(ch)}/15</em></span></button>`).join('')}</aside><main class=\"p64CampaignMap\"><div class=\"p64MapAtmosphere\"></div><header><div><small>${UI.campaignMode==='elite'?'DIFICULDADE ELITE':'JORNADA PRINCIPAL'}</small><h2>${chapterNames[P64.campaignChapter-1]}</h2><p>${chapterCopy[P64.campaignChapter-1]}</p></div><strong>${P64.campaignChapter}<span>/03</span></strong></header><div class=\"p64Path\"><i class=\"p64PathLine\"></i>${p64StageList().map((s,i)=>{const done=p64Map()[s.id],un=stageUnlocked(s),active=selected?.id===s.id;return `<button class=\"p64StageNode ${s.boss?'boss':''} ${done?'done':''} ${!un?'locked':''} ${active?'active':''}\" onclick=\"UI.p64CampaignStage('${s.id}')\"><span>${s.boss?'♛':i+1}</span><b>${s.id}</b><small>${done?'★'.repeat(done.stars):un?'PRONTO':'BLOQUEADO'}</small></button>`}).join('')}</div>${p64ChapterRewardBar(P64.campaignChapter)}</main><aside class=\"p64CampaignDetail\">${p64StageDetail(selected)}</aside></div>`;if(window.NerdoraUI?.enhance)setTimeout(()=>NerdoraUI.enhance(),0)};\nUI.p64CampaignChapter=function(ch){P64.campaignChapter=ch;P64.campaignStage=null;renderCampaign()};\nUI.p64CampaignStage=function(id){P64.campaignStage=id;renderCampaign()};\nUI.p64CampaignMode=function(elite){if(elite&&!isUnlocked('elite'))return toast('Campanha Elite ainda bloqueada');UI.campaignMode=elite?'elite':'normal';P64.campaignStage=null;renderCampaign()};\n\nfunction p64PortalRates(type){const cfg=D.gacha[type];return Object.entries(cfg.rates).map(([r,v])=>`<span class=\"r-${r}\"><b>${r}</b><em>${(Number(v)*100).toFixed(0)}%</em></span>`).join('')}\nrenderGacha=function(){const free=canFreePremium();$('#screen').innerHTML=`${title('Portal','Invocação de heróis e fragmentos')}<div class=\"p64PortalShell\"><section class=\"p64Portal normal\"><div class=\"p64PortalGlow\"></div><div class=\"p64PortalOrb\"><i></i><span>◈</span></div><div class=\"p64PortalCopy\"><small>PORTAL DE OURO</small><h2>${esc(D.gacha.normal.name)}</h2><p>Invocação básica para ampliar sua coleção e acumular fragmentos.</p><div class=\"p64Rates\">${p64PortalRates('normal')}</div></div><div class=\"p64PortalActions\"><button onclick=\"Game.summon('normal',1)\"><small>INVOCAR 1X</small><b>${fmt(D.gacha.normal.singleCost)} 🪙</b></b