{"version":"10.7.0","base":"builds/v10.1.1.html","baseSha":"0a13eea6631d2e4cee485fbeb723c2d9d0d65307","ops":[{"start":0,"end":257,"text":"<!doctype html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><meta name=\"theme-color\" content=\"#0d1020\"><title>Nerdora Chibi Raiders — FASE 6.UI.8</title><style>:root{\n"},{"start":122672,"end":122684,"text":"}\n</style>\n\n\n"},{"start":123854,"end":123865,"text":"}\n</style>\n\n\n<style id=\"p62-city-remaster\">\n/* =========================================================\n   FASE 6.UI.2 · NERDORA CITY REMASTER\n   Fixed-screen premium city HUD — no document scrolling.\n   ========================================================= */\n#app.lobby-mode #screen{padding:0!important;overflow:hidden!important}\n.cityRemaster{--cityGlass:rgba(12,14,27,.76);--cityGlass2:rgba(24,18,42,.84);--cityLine:rgba(214,178,95,.42);--cityPurple:#8f63ff;--cityGold:#efc66b;isolation:isolate}\n.cityRemaster .cityBackdrop{filter:saturate(1.06) contrast(1.035) brightness(.96);transform:scale(1.008)}\n.cityRemaster .cityShade{z-index:1;background:linear-gradient(180deg,rgba(5,8,19,.58) 0%,rgba(5,8,19,.12) 18%,rgba(5,8,19,0) 47%,rgba(3,5,13,.18) 68%,rgba(3,4,11,.74) 100%),linear-gradient(90deg,rgba(5,6,16,.50),transparent 15%,transparent 85%,rgba(5,6,16,.50))}\n.cityAurora{position:absolute;inset:-18%;z-index:2;pointer-events:none;opacity:.46;background:radial-gradient(circle at 50% 54%,rgba(123,78,255,.12),transparent 30%),radial-gradient(circle at 70% 20%,rgba(63,208,255,.08),transparent 22%),radial-gradient(circle at 26% 30%,rgba(255,194,89,.07),transparent 18%);mix-blend-mode:screen;animation:cityAuroraFloat 10s ease-in-out infinite alternate}\n.cityVignette{position:absolute;inset:0;z-index:3;pointer-events:none;box-shadow:inset 0 0 120px rgba(0,0,0,.34),inset 0 -90px 100px rgba(2,4,12,.38)}\n@keyframes cityAuroraFloat{from{transform:translate3d(-1%,0,0) scale(1)}to{transform:translate3d(1%,1%,0) scale(1.035)}}\n.cityGlass{backdrop-filter:blur(14px) saturate(1.18);-webkit-backdrop-filter:blur(14px) saturate(1.18)}\n\n.cityRemaster .cityTopHud{left:1%;right:1%;top:1.2%;height:clamp(48px,9vh,76px);align-items:stretch;gap:.7vw;z-index:40;pointer-events:none}\n.cityRemaster .cityProfile{pointer-events:auto;position:relative;height:100%;min-width:clamp(190px,21.5vw,322px);padding:0 1vw 0 clamp(52px,5.5vw,78px);border-radius:17px;background:linear-gradient(120deg,rgba(42,28,72,.92),rgba(15,17,33,.88) 64%);border:1px solid rgba(235,200,123,.54);box-shadow:0 10px 28px rgba(0,0,0,.32),inset 0 1px 0 rgba(255,255,255,.08)}\n.cityRemaster .cityProfile:after{display:none}\n.cityRemaster .cityAvatarFrame{left:5px;width:clamp(43px,5vw,66px);border-radius:16px;padding:3px;background:linear-gradient(145deg,#ffd985,#7f52ff 48%,#241837 72%);box-shadow:0 0 0 1px rgba(255,255,255,.12),0 6px 18px rgba(0,0,0,.42),0 0 19px rgba(143,99,255,.24)}\n.cityRemaster .cityAvatarInner{border-radius:13px;overflow:hidden;background:radial-gradient(circle at 50% 30%,#7d5ac4,#1d1730 72%);font-size:clamp(19px,2vw,30px)}\n.cityRemaster .cityAvatarInner img{width:100%;height:100%;object-fit:cover;display:block}\n.cityRemaster .cityLevelOrb{left:0;bottom:-4px;width:clamp(22px,2.1vw,30px);height:clamp(22px,2.1vw,30px);border:2px solid #f1c86e;background:#111526;font-size:clamp(7px,.7vw,10px)}\n.cityRemaster .cityProfileCopy{display:grid;grid-template-columns:auto 1fr;grid-template-rows:auto auto;column-gap:8px;align-items:center;line-height:1;min-width:0}\n.cityRemaster .cityProfileCopy>small{grid-column:1/3;color:#a99cc7;font-size:clamp(6px,.56vw,8px);font-weight:900;letter-spacing:.16em;margin-bottom:3px}\n.cityRemaster .cityProfileName{font:900 clamp(10px,1vw,15px) Inter,system-ui,sans-serif;color:#fff;max-width:13vw;text-shadow:none}\n.cityRemaster .cityVip{margin:0;padding:3px 7px;font-size:clamp(6px,.58vw,8px);justify-self:start;background:linear-gradient(180deg,#7d5823,#382510);border-color:rgba(239,198,107,.72)}\n\n.cityRemaster .cityResources{pointer-events:auto;flex:1;max-width:48vw;display:grid;grid-template-columns:repeat(3,minmax(100px,1fr));gap:5px;padding:5px;border:1px solid rgba(185,159,218,.19);border-radius:17px;background:rgba(8,11,23,.66);box-shadow:0 8px 24px rgba(0,0,0,.25)}\n.cityRemaster .cityResource{height:100%;min-width:0;justify-content:flex-start;gap:8px;padding:0 28px 0 10px;border:0;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.018));box-shadow:none;text-shadow:none}\n.cityRemaster .cityResource:after{display:none}\n.cityRemaster .resIcon{width:clamp(24px,2.5vw,34px);height:clamp(24px,2.5vw,34px);display:grid;place-items:center;border-radius:11px;font-size:clamp(14px,1.5vw,20px);font-weight:1000;box-shadow:inset 0 0 0 1px rgba(255,255,255,.12)}\n.cityRemaster .resIcon.gold{color:#ffd770;background:rgba(199,139,39,.18)}.cityRemaster .resIcon.gems{color:#66eaff;background:rgba(70,191,230,.15)}.cityRemaster .resIcon.energy{color:#f0c66d;background:rgba(232,170,59,.15)}\n.cityRemaster .resCopy{display:flex;min-width:0;flex-direction:column;align-items:flex-start;gap:1px}.cityRemaster .resCopy small{font-size:clamp(5px,.5vw,7px);font-weight:900;letter-spacing:.09em;color:#8f96ae}.cityRemaster .resCopy b{font-size:clamp(9px,.93vw,13px);color:#f8faff;white-space:nowrap}\n.cityRemaster .cityResource .plus{right:5px;width:clamp(19px,1.8vw,25px);height:clamp(19px,1.8vw,25px);border-radius:8px;border:1px solid rgba(183,255,197,.66);font-size:clamp(12px,1.1vw,16px);background:linear-gradient(180deg,#39c55e,#187d38)}\n.cityTopMeta{pointer-events:auto;min-width:clamp(145px,16vw,230px);height:100%;display:flex;align-items:center;justify-content:flex-end;gap:8px;padding:5px 7px 5px 11px;border-radius:17px;background:rgba(8,11,23,.72);border:1px solid rgba(185,159,218,.19);box-shadow:0 8px 24px rgba(0,0,0,.25)}\n.cityTopMeta>div{min-width:0;display:flex;flex-direction:column;gap:2px}.cityTopMeta small{font-size:clamp(5px,.5vw,7px);font-weight:900;letter-spacing:.08em;color:#8b93aa}.cityTopMeta b{font:800 clamp(7px,.72vw,10px) ui-monospace,monospace;color:#eef1ff;white-space:nowrap}.cityOnlineDot{width:8px;height:8px;border-radius:50%}.cityOnlineDot.online{background:#5ae189;box-shadow:0 0 10px #5ae189}.cityOnlineDot.local{background:#e8b95f;box-shadow:0 0 9px #e8b95f88}.cityTopMeta button{width:clamp(28px,2.6vw,36px);aspect-ratio:1;border:0;border-radius:11px;background:rgba(143,99,255,.13);color:#d9cfff;font-size:clamp(13px,1.3vw,18px);cursor:pointer}\n\n.cityRemaster .cityEventRow{left:50%;top:11.6%;transform:translateX(-50%);gap:4px;padding:4px;border-radius:15px;background:rgba(8,10,21,.60);border:1px solid rgba(187,154,222,.18);z-index:34}\n.cityRemaster .cityMiniBtn{width:clamp(57px,5.6vw,76px);height:clamp(42px,6.5vh,56px);border-radius:11px;border:1px solid transparent;background:rgba(255,255,255,.035);box-shadow:none;transition:.18s ease}\n.cityRemaster .cityMiniBtn:hover{background:rgba(143,99,255,.14);border-color:rgba(188,155,255,.32);transform:translateY(-1px)}\n.cityRemaster .cityMiniBtn svg{width:25px;height:25px;color:#e6c56e}.cityRemaster .cityMiniBtn span{font:800 clamp(6px,.57vw,8px) Inter,system-ui,sans-serif;margin-top:1px;color:#f1edff}\n.cityRemaster .p57CityAngelIcon{font-size:21px!important}\n\n.cityRemaster .cityRail{top:23%;bottom:auto;display:flex;flex-direction:column;justify-content:flex-start;gap:5px;padding:6px;border-radius:18px;background:rgba(8,10,21,.64);border:1px solid rgba(192,166,222,.18);box-shadow:0 12px 28px rgba(0,0,0,.28);z-index:33}\n.cityRemaster .cityLeftMenu{left:1%}.cityRemaster .cityRightMenu{right:1%}\n.cityRailTitle{height:clamp(31px,5vh,42px);display:flex;flex-direction:column;justify-content:center;padding:0 8px;border-bottom:1px solid rgba(255,255,255,.08);margin-bottom:1px}.cityRailTitle small{font-size:clamp(5px,.48vw,7px);font-weight:900;letter-spacing:.13em;color:#8d94aa}.cityRailTitle b{font-size:clamp(7px,.68vw,10px);color:#f4efff}\n.cityRemaster .cityMenuBtn{width:clamp(54px,5.6vw,76px);height:clamp(46px,7.5vh,65px);border-radius:13px;border:1px solid transparent;background:rgba(255,255,255,.035);box-shadow:none;padding:4px;transition:.18s ease}\n.cityRemaster .cityMenuBtn:after{display:none}.cityRemaster .cityMenuBtn:hover{background:rgba(143,99,255,.14);border-color:rgba(188,155,255,.34);transform:translateX(2px);filter:none}.cityRemaster .cityRightMenu .cityMenuBtn:hover{transform:translateX(-2px)}\n.cityRemaster .cityMenuBtn svg{width:29px;height:29px;color:#e3c36b;filter:drop-shadow(0 0 8px rgba(226,195,107,.15))}.cityRemaster .cityMenuBtn .lbl{position:static;min-height:0;margin-top:1px;padding:0;border:0;background:none;font:800 clamp(5.5px,.55vw,8px) Inter,system-ui,sans-serif;color:#f0edfa;text-shadow:none}\n.cityRemaster .cityNotify{right:0;top:0;min-width:15px;height:15px;padding:0 4px;border:1px solid #ffd1d1;font-size:7px}\n\n.cityTeamHalo{position:absolute;left:50%;top:34%;width:38vw;height:32vh;transform:translateX(-50%);z-index:4;pointer-events:none;background:radial-gradient(ellipse at center,rgba(121,81,230,.13),rgba(121,81,230,.035) 48%,transparent 70%);filter:blur(4px)}\n.cityRemaster .cityHeroes{left:17%;right:17%;top:22%;bottom:16%;z-index:12}\n.cityRemaster .cityHeroActor{height:clamp(112px,32vh,280px);width:clamp(105px,16vw,240px);filter:drop-shadow(0 13px 8px rgba(0,0,0,.48));transition:filter .18s ease,transform .18s ease}\n.cityRemaster .cityHeroActor img{animation-duration:4.2s}.cityRemaster .cityHeroName{bottom:0;padding:3px 8px;border:1px solid rgba(229,200,135,.42);background:rgba(8,10,21,.72);font:800 clamp(5.5px,.55vw,8px) Inter,system-ui,sans-serif;color:#f8f5ff;backdrop-filter:blur(8px)}\n.cityRemaster .cityHeroActor:hover{filter:drop-shadow(0 13px 8px rgba(0,0,0,.48)) drop-shadow(0 0 18px rgba(143,99,255,.52))}\n.cityTeamPlate{position:absolute;left:50%;bottom:14.4%;transform:translateX(-50%);z-index:30;width:clamp(220px,25vw,350px);height:clamp(42px,6.6vh,56px);display:flex;align-items:center;gap:10px;padding:5px 12px 5px 7px;border-radius:15px;border:1px solid rgba(230,198,125,.42);background:linear-gradient(115deg,rgba(30,20,50,.83),rgba(9,12,25,.79));box-shadow:0 9px 26px rgba(0,0,0,.31);color:#fff;text-align:left;cursor:pointer}\n.cityTeamPlate:hover{border-color:rgba(181,145,255,.6);box-shadow:0 9px 26px rgba(0,0,0,.31),0 0 18px rgba(143,99,255,.13)}.cityTeamIcon{width:clamp(30px,3vw,40px);aspect-ratio:1;display:grid;place-items:center;border-radius:12px;background:linear-gradient(145deg,#7b57d9,#31234d);font-size:clamp(15px,1.6vw,22px);box-shadow:inset 0 0 0 1px rgba(255,255,255,.1)}\n.cityTeamPlate>span:nth-child(2){display:grid;grid-template-columns:auto 1fr;grid-template-rows:auto auto;column-gap:8px;flex:1;min-width:0;align-items:center}.cityTeamPlate small{grid-column:1/3;font-size:clamp(5px,.48vw,7px);font-weight:900;letter-spacing:.12em;color:#9ba1b8}.cityTeamPlate b{font-size:clamp(11px,1.1vw,16px);color:#ffd977}.cityTeamPlate em{font-style:normal;font-size:clamp(5.5px,.55vw,8px);color:#bbb9ca;white-space:nowrap}.cityTeamPlate>i{font-style:normal;font-size:24px;color:#cab6ff}\n\n.cityRemaster .cityBottomDock{left:50%;bottom:1%;gap:4px;padding:5px;border-radius:20px;background:rgba(8,10,21,.76);border:1px solid rgba(205,174,110,.28);box-shadow:0 13px 34px rgba(0,0,0,.42);z-index:38}\n.cityRemaster .cityBottomDock:before{display:none}.cityRemaster .cityDockBtn{width:clamp(65px,7.1vw,102px);height:clamp(50px,8.6vh,72px);border-radius:14px;border:1px solid transparent;background:rgba(255,255,255,.035);box-shadow:none;transition:.18s ease;padding:5px}.cityRemaster .cityDockBtn:after{display:none}.cityRemaster .cityDockBtn:first-child{background:linear-gradient(145deg,rgba(113,72,191,.76),rgba(39,27,64,.88));border-color:rgba(234,201,126,.6);transform:translateY(-4px);box-shadow:0 7px 18px rgba(70,39,123,.31)}\n.cityRemaster .cityDockBtn:hover{background:rgba(143,99,255,.16);border-color:rgba(188,155,255,.35);transform:translateY(-2px);filter:none}.cityRemaster .cityDockBtn:first-child:hover{transform:translateY(-6px)}\n.cityRemaster .cityDockBtn svg{width:29px;height:29px;color:#edcd76;filter:none}.cityRemaster .cityDockBtn .lbl{margin-top:1px;font:800 clamp(5.5px,.57vw,8px) Inter,system-ui,sans-serif;color:#f3efff;text-shadow:none}.cityRemaster .cityDockBtn.locked{opacity:.4;filter:grayscale(.7)}\n.cityRemaster .cityVersion{display:none!important}\n.cityRemaster .cityQuickToast{display:none}\n\n@media(max-height:500px) and (orientation:landscape){\n .cityRemaster .cityTopHud{top:.8%;height:clamp(43px,13vh,52px)}\n .cityRemaster .cityProfile{min-width:190px;padding-left:50px}.cityRemaster .cityAvatarFrame{width:42px}.cityRemaster .cityProfileName{max-width:120px}.cityRemaster .cityResources{max-width:46vw;padding:3px}.cityRemaster .cityResource{padding-left:7px;gap:5px}.cityRemaster .resIcon{width:24px;height:24px}.cityTopMeta{min-width:135px;padding:3px 5px}\n .cityRemaster .cityEventRow{top:15.3%;padding:3px}.cityRemaster .cityMiniBtn{width:53px;height:39px}.cityRemaster .cityMiniBtn svg{width:21px;height:21px}\n .cityRemaster .cityRail{top:25.5%;gap:3px;padding:4px}.cityRailTitle{display:none}.cityRemaster .cityMenuBtn{width:50px;height:45px;border-radius:11px}.cityRemaster .cityMenuBtn svg{width:24px;height:24px}.cityRemaster .cityMenuBtn .lbl{font-size:5.5px}\n .cityRemaster .cityHeroes{left:15%;right:15%;top:23%;bottom:14%}.cityRemaster .cityHeroActor{height:clamp(95px,36vh,150px);width:clamp(90px,14vw,150px)}\n .cityTeamPlate{bottom:15%;height:38px;width:230px;padding:3px 8px;gap:7px}.cityTeamIcon{width:28px}.cityTeamPlate em{font-size:5px}\n .cityRemaster .cityBottomDock{bottom:.5%;padding:3px;gap:2px;border-radius:14px}.cityRemaster .cityDockBtn{width:clamp(53px,7.2vw,72px);height:clamp(42px,13vh,52px);border-radius:10px}.cityRemaster .cityDockBtn svg{width:23px;height:23px}.cityRemaster .cityDockBtn .lbl{font-size:5.5px}\n}\n@media(min-width:1200px) and (min-height:650px){\n .cityRemaster .cityHeroes{left:19%;right:19%;top:24%;bottom:15%}.cityRemaster .cityHeroActor{height:clamp(150px,34vh,295px)}\n .cityRemaster .cityMenuBtn{width:76px;height:66px}.cityRemaster .cityDockBtn{width:98px;height:70px}\n}\n</style>\n<style id=\"phase6-ui6-style\">\n/* ========================================================================== */\n/* FASE 6.UI.6 · CRÔNICAS + RENASCIMENTO + CONSTELAÇÃO + DIVINDADE           */\n/* ========================================================================== */\n:root{--p66-gold:#e6bd6b;--p66-gold2:#8c6125;--p66-violet:#9b75e7;--p66-violet2:#4b2d77;--p66-blue:#74b8ff;--p66-ink:#070b14;--p66-panel:#101827;--p66-line:#344158;--p66-green:#66d5a4}\n.p52PanelBody:has(.p66AscHub),.p52PanelBody:has(.p66ChronBook){overflow:hidden!important;padding:7px 9px 9px!important}\n.p66AscHub,.p66ChronBook{height:100%;min-height:0;overflow:hidden;border:1px solid rgba(189,154,102,.18);border-radius:15px;background:linear-gradient(160deg,rgba(16,22,36,.97),rgba(7,10,18,.98));box-shadow:inset 0 1px rgba(255,255,255,.025),0 15px 40px rgba(0,0,0,.24)}\n.p66AscHub{display:grid;grid-template-columns:150px minmax(0,1fr)}\n.p66AscRail{padding:10px 8px;border-right:1px solid rgba(183,149,225,.16);background:linear-gradient(180deg,#12192a,#0a0f1b);display:flex;flex-direction:column;gap:7px;min-height:0}\n.p66AscRailHead{padding:5px 7px 9px;border-bottom:1px solid #28354b}.p66AscRailHead small{display:block;font-size:6px;letter-spacing:.15em;color:#8f9cb5;font-weight:900}.p66AscRailHead b{display:block;margin-top:3px;color:#f5e6c5;font-size:12px}\n.p66AscTab{width:100%;display:grid;grid-template-columns:27px 1fr;align-items:center;gap:7px;text-align:left;padding:9px 7px;border:1px solid #303c52;border-radius:11px;background:#101828;color:#aeb9cb;box-shadow:none}.p66AscTab i{font-style:normal;width:27px;height:27px;display:grid;place-items:center;border-radius:9px;background:#182338;border:1px solid #37465f;font-size:14px}.p66AscTab span b,.p66AscTab span small{display:block}.p66AscTab span b{font-size:7px;color:#d6deec}.p66AscTab span small{font-size:5.5px;color:#78869d;margin-top:2px}.p66AscTab.active{border-color:#a77bdc;background:linear-gradient(135deg,#392653,#1c2238);box-shadow:0 0 22px rgba(150,100,226,.15)}.p66AscTab.active i{border-color:#d4a85c;background:linear-gradient(145deg,#6c4b1e,#2f2240);color:#ffe2a0}.p66AscRailResources{margin-top:auto;display:grid;gap:4px}.p66AscRailResources span{display:flex;justify-content:space-between;gap:5px;padding:5px 6px;border:1px solid #28354a;border-radius:8px;background:#0b111e;font-size:5.5px;color:#8795ac}.p66AscRailResources b{color:#e7d6b0;font-size:6px}\n.p66AscStage{min-width:0;min-height:0;display:flex;flex-direction:column;overflow:hidden}.p66AscHero{height:54px;flex:0 0 54px;display:flex;align-items:center;justify-content:space-between;padding:7px 11px;border-bottom:1px solid #2b374d;background:linear-gradient(90deg,rgba(73,48,105,.25),rgba(17,24,39,.55))}.p66AscHero small{font-size:5.5px;letter-spacing:.14em;color:#9b8ab6;font-weight:900}.p66AscHero h3{margin:2px 0 0;font-size:12px;color:#f4e3bf}.p66AscHero p{margin:2px 0 0;font-size:5.5px;color:#8492aa}.p66AscHero strong{font-size:21px;color:#e9c26f;line-height:1}.p66AscBody{min-height:0;flex:1;overflow:hidden;padding:8px}\n.p66RebirthLayout{height:100%;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(210px,.65fr);gap:8px;min-height:0}.p66RebirthRoad{min-height:0;position:relative;border:1px solid #2f3c53;border-radius:13px;background:radial-gradient(circle at 50% 45%,rgba(133,90,190,.11),transparent 42%),linear-gradient(180deg,#0f1726,#090e18);padding:9px;overflow:hidden}.p66RebirthRoad:before{content:\"\";position:absolute;left:10%;right:10%;top:50%;height:1px;background:linear-gradient(90deg,transparent,#6a557d,#c5944e,#6a557d,transparent);opacity:.65}.p66RebirthNodes{height:100%;display:grid;grid-template-columns:repeat(5,1fr);grid-template-rows:repeat(2,1fr);gap:8px;position:relative;z-index:1}.p66RebirthNode{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:2px;border:1px solid #344159;border-radius:12px;background:linear-gradient(180deg,#121b2b,#0a111d);color:#738099;min-width:0}.p66RebirthNode em{font-style:normal;font-size:19px;line-height:1;color:#53617b}.p66RebirthNode b{font-size:7px;color:#a9b3c4}.p66RebirthNode small{font-size:4.5px;color:#6f7b8f;max-width:92%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.p66RebirthNode.done{border-color:#5f7f67;background:linear-gradient(180deg,#153026,#0c1d18);box-shadow:inset 0 0 15px rgba(64,187,129,.08)}.p66RebirthNode.done em{color:#77d9a5}.p66RebirthNode.next{border-color:#c99d52;background:linear-gradient(180deg,#362713,#17120b);box-shadow:0 0 18px rgba(216,167,77,.15)}.p66RebirthNode.next em{color:#ffd889}.p66RebirthSide{display:flex;flex-direction:column;min-height:0;border:1px solid #38445b;border-radius:13px;background:linear-gradient(180deg,#141c2c,#0b111e);padding:9px;overflow:auto;overscroll-behavior:contain}.p66NextKicker{font-size:5.5px;letter-spacing:.13em;color:#a08ab9;font-weight:900}.p66RebirthSide h4{margin:3px 0 5px;color:#ffe0a0;font-size:12px}.p66RebirthSide>p{margin:0 0 7px;font-size:6px;color:#909db2;line-height:1.4}.p66CostLine{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:6px}.p66CostLine span{padding:4px 6px;border-radius:8px;border:1px solid #3b465b;background:#0b1220;font-size:5.5px;color:#d1d9e8}.p66ReqMini{display:grid;grid-template-columns:1fr 1fr;gap:4px;margin-bottom:7px}.p66ReqMini span{display:flex;justify-content:space-between;padding:4px 5px;border-radius:7px;border:1px solid #3b4558;background:#101625;font-size:5px;color:#8794a9}.p66ReqMini span.ok{border-color:#326d54;color:#8dd4b4;background:#10251d}.p66AscAction{margin-top:auto;width:100%;padding:8px 7px;border-radius:10px;bor