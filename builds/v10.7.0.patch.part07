"p67MissionSummary\"><span><small>COLETADAS</small><b>${done}/${defs.length}</b></span><span><small>SWEEPS</small><b>${state.weekly.sweeps||0}</b></span><span><small>DOAÇÕES</small><b>${state.weekly.guildDonations||0}</b></span><span><small>INCURSÃO</small><b>${state.weekly.raidWins||0}</b></span></div><div class=\"p67MissionList\">${defs.map(weeklyMission).join('')}</div>`}\n  function missionAfkView(){const a=afkPreview();return `<div class=\"p67Afk\"><section class=\"p67AfkChest\"><i>🎁</i><h3>Baú AFK</h3><p>${a.minutes} min acumulados · limite de 8 horas</p><div class=\"p67BonusRow\" style=\"width:min(360px,90%);margin:5px 0 8px\"><span>🪙 Ouro <b>${fmt(a.gold)}</b></span><span>✨ EXP <b>${fmt(a.exp)}</b></span><span>⏱ Tempo <b>${a.minutes}m</b></span></div><button class=\"p67Btn gold\" onclick=\"Game.claimAfk()\" ${a.minutes<1?'disabled':''}>COLETAR RECOMPENSAS</button></section><aside class=\"p67Unlocks\">${D.unlocks.map(u=>{const on=state.player.level>=u.level;return `<article class=\"p67Unlock ${on?'on':''}\"><i>${on?'✓':'🔒'}</i><div><b>${esc(u.name)}</b><small>Requisito: nível ${u.level}</small></div><strong>${on?'LIBERADO':`NV.${u.level}`}</strong></article>`}).join('')}</aside></div>`}\n  window.renderMissions=function(){const tabs=[['daily','📜','Hoje','Missões diárias',missionHasClaim()?'!':''],['weekly','📅','Semana','Objetivos semanais'],['afk','🎁','AFK','Baú e desbloqueios']];const left=rail('Central de Missões','PROGRESSÃO',tabs,UI.p67MissionTab,'UI.p67Mission');const dailyDone=missionDefs.filter(m=>state.daily.claimed[m.id]).length;const head=hero('MISSÕES E RECOMPENSAS','Central de Missões','Objetivos diários, semanais e progresso offline',[['DIÁRIAS',`${dailyDone}/${missionDefs.length}`],['NÍVEL',state.player.level],['ENERGIA',`${state.player.energy}/${state.player.maxEnergy}`]]);const views={daily:missionDailyView(),weekly:missionWeeklyView(),afk:missionAfkView()};$('#screen').innerHTML=`${title('Missões','Central de progressão')} ${shell(left,head,views[UI.p67MissionTab]||views.daily)}`};\n  try{renderMissions=window.renderMissions}catch(e){}\n  Game.p67ClaimAllDaily=function(){let n=0;for(const m of missionDefs){if(state.daily.claimed[m.id]||(state.daily[m.key]||0)<m.need)continue;for(const [k,v] of Object.entries(m.reward)){if(k==='gold'||k==='gems')state.player[k]+=v;else if(k==='trial_coin')state.currencies.trial+=v;else addResource(k,v)}state.daily.claimed[m.id]=true;n++}if(n){save();renderMissions();toast(`${n} recompensa${n>1?'s':''} coletada${n>1?'s':''}`)}};\n  Game.claimWeekly=function(id){const m=D.phase4.weeklyMissions.find(x=>x.id===id);if(!m||state.weekly.claimed[id]||(state.weekly[m.key]||0)<m.need)return;for(const [k,v] of Object.entries(m.reward)){if(k==='gold'||k==='gems')state.player[k]+=v;else if(k==='guild_coin')state.currencies.guild+=v;else if(k==='event_coin')state.currencies.event+=v;else addResource(k,v)}state.weekly.claimed[id]=true;save();if(UI.route==='missions')renderMissions();else renderModes();toast('Recompensa semanal coletada')};\n\n  function settingSwitch(icon,name,copy,key){const on=!!state.phase67Prefs[key];return `<article class=\"p67Setting\"><i>${icon}</i><div><b>${esc(name)}</b><small>${esc(copy)}</small></div><button class=\"p67Switch ${on?'on':''}\" onclick=\"Game.p67ToggleSetting('${key}')\" aria-label=\"${esc(name)}\"><i></i></button></article>`}\n  function settingsGame(){return `<div class=\"p67Grid2\"><section class=\"p67Card\"><div class=\"p67CardHead\"><div><small>INTERFACE</small><b>Preferências visuais</b></div><i>◈</i></div><div class=\"p67SettingRows\">${settingSwitch('✨','Reduzir animações','Minimiza transições e efeitos animados.','reducedMotion')}${settingSwitch('▰','HUD compacto','Reduz a altura da barra superior durante a navegação.','compactHud')}</div></section><section class=\"p67Card\"><div class=\"p67CardHead\"><div><small>LABORATÓRIO</small><b>Modo de desenvolvimento</b></div><i>🧪</i></div><p>Libera recursos e heróis para testar sistemas sem grind. Não altera a estrutura das telas.</p><button class=\"p67Btn ${state.lab?'green':'violet'}\" onclick=\"UI.toggleLab()\">${state.lab?'DESATIVAR LAB':'ATIVAR LABORATÓRIO'}</button></section></div>`}\n  function settingsSave(){const bridge=window.NerdoraChibiBridge,connected=!!bridge?.connected,profile=bridge?.profile,name=profile?.publicName||profile?.username||'Perfil local',sync=state.nerdoraSync?.lastSyncAt?new Date(state.nerdoraSync.lastSyncAt).toLocaleString('pt-BR'):'Ainda não sincronizado';return `<div class=\"p67Grid2\"><section class=\"p67Card\"><div class=\"p67CardHead\"><div><small>IDENTIDADE</small><b>Nerdora</b></div><i>☁</i></div><div class=\"p67Status\"><i>${connected?'☁':'⌂'}</i><div><b>${esc(name)}</b><small>${connected?'Conectado ao Nerdora':'Executando em modo local'}</small></div><strong>${connected?'ONLINE':'LOCAL'}</strong></div><p>Última sincronização: ${esc(sync)}</p><button class=\"p67Btn violet\" onclick=\"Game.p67CloudSync()\" ${connected?'':'disabled'}>SINCRONIZAR AGORA</button></section><section class=\"p67Card\"><div class=\"p67CardHead\"><div><small>PROGRESSO</small><b>Save do jogo</b></div><i>💾</i></div><div class=\"p67SettingRows\"><article class=\"p67Setting\"><i>💾</i><div><b>Salvar agora</b><small>Grava imediatamente o progresso local.</small></div><button class=\"p67Btn green\" onclick=\"save();toast('Save realizado')\">SALVAR</button></article><article class=\"p67Setting p67Danger\"><i>⚠️</i><div><b>Reiniciar progresso</b><small>Apaga o save local e recomeça o jogo.</small></div><button class=\"p67Btn red\" onclick=\"UI.reset()\">RESETAR</button></article></div></section></div>`}\n  function settingsQuick(){return `<div class=\"p67QuickGrid\"><button class=\"p67Quick\" onclick=\"Game.openShop()\"><i>🛒</i><b>Loja</b><small>Recursos e moedas</small></button><button class=\"p67Quick\" onclick=\"UI.modeTab='arena';UI.nav('modes')\"><i>🏟️</i><b>Arena</b><small>PvP assíncrono</small></button><button class=\"p67Quick\" onclick=\"Game.startBoss()\"><i>🐉</i><b>Chefe Épico</b><small>Desafio avançado</small></button><button class=\"p67Quick\" onclick=\"UI.nav('inventory')\"><i>🎒</i><b>Inventário</b><small>Itens e materiais</small></button></div>`}\n  window.renderSettings=function(){const tabs=[['game','⚙','Jogo','Interface e laboratório'],['save','☁','Save & Nerdora','Conta e sincronização'],['quick','◇','Atalhos','Acesso rápido']];const left=rail('Configurações','SISTEMA',tabs,UI.p67SettingsTab,'UI.p67Settings');const bridge=window.NerdoraChibiBridge;const head=hero('NERDORA CHIBI RAIDERS','Configurações','Preferências, save e conexão com o ecossistema Nerdora',[['VERSÃO','10.6.0'],['SAVE','AUTO'],['NERDORA',bridge?.connected?'ON':'LOCAL']]);const views={game:settingsGame(),save:settingsSave(),quick:settingsQuick()};$('#screen').innerHTML=`${title('Configurações','Preferências e sistema')} ${shell(left,head,views[UI.p67SettingsTab]||views.game)}`};\n  try{renderSettings=window.renderSettings}catch(e){}\n  Game.p67ToggleSetting=function(key){if(!(key in state.phase67Prefs))return;state.phase67Prefs[key]=!state.phase67Prefs[key];applyPrefs();save();renderSettings()};\n  Game.p67CloudSync=function(){const b=window.NerdoraChibiBridge;if(!b?.connected)return toast('Nerdora não conectado');try{b.post('NERDORA_CHIBI_SAVE',{save:b.snapshot()});state.nerdoraSync={...(state.nerdoraSync||{}),lastSyncAt:Date.now()};save();renderSettings();toast('Sincronização enviada ao Nerdora')}catch(e){toast('Falha ao sincronizar')}};\n\n  const shopOffers=[['skill_book','📘','5 Livros de Skill','Aprimore habilidades ativas, passivas e Ultimates.',5,500],['rune_stone','🌀','120 Pedras Rúnicas','Material para evolução e fortalecimento de Runas.',120,700],['awaken_essence','🌟','40 Essências de Awakening','Recurso avançado para o Despertar dos heróis.',40,900]];\n  function shopResources(){return `<div class=\"p67OfferGrid\">${shopOffers.map(o=>`<article class=\"p67Offer\"><i>${o[1]}</i><div><h4>${o[2]}</h4><p>${o[3]}</p></div><div class=\"p67OfferPrice\"><b>💎 ${o[5]}</b><button class=\"p67Btn violet\" onclick=\"Game.buyShop('${o[0]}',${o[4]},${o[5]})\" ${state.player.gems<o[5]?'disabled':''}>COMPRAR</button></div></article>`).join('')}</div>`}\n  function shopCurrencies(){return `<div class=\"p67Destination\"><button onclick=\"Game.p67ShopGo('modes','arena')\"><i>🏟️</i><div><b>Loja da Arena</b><small>Saldo atual: ${fmt(state.currencies.arena||0)} moedas</small></div><em>›</em></button><button onclick=\"Game.p67ShopGo('modes','trials')\"><i>🏛️</i><div><b>Loja da Provação</b><small>Saldo atual: ${fmt(state.currencies.trial||0)} moedas</small></div><em>›</em></button><button onclick=\"Game.p67ShopGo('modes','events')\"><i>🎟️</i><div><b>Loja de Evento</b><small>Saldo atual: ${fmt(state.currencies.event||0)} moedas</small></div><em>›</em></button><button onclick=\"Game.p67ShopGo('guild')\"><i>🏰</i><div><b>Loja da Guilda</b><small>Saldo atual: ${fmt(state.currencies.guild||0)} moedas</small></div><em>›</em></button></div>`}\n  function shopInfo(){return `<div class=\"p67Grid2\"><section class=\"p67Card\"><div class=\"p67CardHead\"><div><small>ECONOMIA</small><b>Carteira do Raider</b></div><i>◆</i></div><div class=\"p67BonusRow\"><span>🪙 Ouro <b>${fmt(state.player.gold)}</b></span><span>💎 Gemas <b>${fmt(state.player.gems)}</b></span><span>⚡ Energia <b>${state.player.energy}/${state.player.maxEnergy}</b></span></div></section><section class=\"p67Card\"><div class=\"p67CardHead\"><div><small>DICA</small><b>Fontes de recursos</b></div><i>🧭</i></div><p>Campanha, Provações, Arena, Eventos, Guilda e AFK continuam como as principais fontes. A Loja apenas centraliza acessos e compras diretas já existentes.</p></section></div>`}\n  function shopHtml(){const tab=UI.p67ShopTab,content=tab==='resources'?shopResources():tab==='currencies'?shopCurrencies():shopInfo();return `<div class=\"p67ShopShell\"><aside class=\"p67ShopRail\"><div class=\"p67ShopWallet\"><small>CARTEIRA</small><b