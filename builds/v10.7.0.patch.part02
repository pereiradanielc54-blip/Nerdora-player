ay:grid;grid-template-columns:1fr;place-items:center;padding:1px;border:1px solid #34445d;border-radius:6px;background:#122039;color:#b9c7dc}.p68Battle .orderChip.enemy{background:#2b171d;border-color:#5f3440}.p68Battle .orderChip i{font-style:normal;font-size:9px;line-height:1}.p68Battle .orderChip b{font-size:3.4px}.p68Battle .orderChip.current{outline:1px solid #efc86f;box-shadow:0 0 9px #efc86f55}\n.p68Battle .battleCenter{font-size:15px;color:#f0c87812}.p68Battle .battleLog{left:7px;right:auto;bottom:7px;width:min(245px,29vw);height:48px;padding:5px;border-radius:9px;font-size:4.3px;line-height:1.3;background:#060910df;border-color:#29374c;z-index:35}.p68Metrics{position:absolute;right:7px;bottom:7px;z-index:34;width:min(215px,25vw);height:48px;display:grid;grid-template-columns:repeat(3,1fr);gap:3px;padding:4px;border:1px solid #344057;border-radius:9px;background:#070b12df}.p68Metrics span{display:grid;place-items:center;align-content:center;border:1px solid #263146;border-radius:6px;background:#0c1421}.p68Metrics small,.p68Metrics b{display:block;text-align:center}.p68Metrics small{font-size:3.2px;color:#748399}.p68Metrics b{font-size:5.5px;color:#e6d09a}\n.p68Battle .p57AngelBattle{bottom:7px;width:min(275px,35vw);grid-template-columns:36px 1fr auto;gap:4px;padding:4px 5px;border-radius:9px}.p68Battle .p57AngelBattle img{width:34px;height:34px}.p68Battle .p57AngelBattleInfo b{font-size:5.5px}.p68Battle .p57AngelBattle small{font-size:3.6px}.p68Battle .p57AngelEnergyBar{height:4px;margin:2px 0}.p68Battle .p57AngelBattleActions button{padding:3px 4px;font-size:3.7px}\n.p68Impact{position:absolute;z-index:75;width:36px;height:36px;border:2px solid #ffe0a0;border-radius:50%;transform:translate(-50%,-50%);box-shadow:0 0 20px #ffb85e;animation:p68impact .42s ease-out forwards;pointer-events:none}.p68Impact.crit{width:55px;height:55px;border-color:#fff0a8;box-shadow:0 0 30px #ffcf5c}.p68Impact.block{border-color:#9dc8ff;box-shadow:0 0 20px #69aaff}.p68Impact.dodge{border-style:dashed;border-color:#6de6ff;box-shadow:0 0 18px #6de6ff}.p68Unit.p68Act{animation:p68act .38s ease}.p68Unit.p68UltAct{animation:p68ultact .68s ease}.p68Unit.p68Hit{animation:p68hit .32s ease}.p68Unit.p68CritHit{animation:p68crit .5s ease}.p68Unit.p68BlockHit{animation:p68block .38s ease}.p68Unit.p68DodgeHit{animation:p68dodge .38s ease}.p68Battle .floatText{font-size:12px;z-index:90}.p68Battle .floatText.hit{color:#ffe09a}.p68Battle .floatText.dodge{color:#7ce8ff}.p68Battle .floatText.block{color:#a9ccff}.p68UltBanner{position:absolute;left:50%;top:50%;z-index:100;width:min(500px,58vw);height:92px;display:flex;align-items:center;gap:12px;padding:7px 18px;transform:translate(-50%,-50%);border:1px solid #d1a95b;border-radius:12px;background:linear-gradient(90deg,#0a0d15f7,#2c2039f4,#0a0d15f7);box-shadow:0 0 0 100vmax #02040a88,0 0 35px #b183e066;overflow:hidden;animation:p68banner .88s ease both;pointer-events:none}.p68UltBanner.enemy{border-color:#b85d69;background:linear-gradient(90deg,#0a0d15f7,#3a1d26f4,#0a0d15f7)}.p68UltBanner img{height:125%;max-width:35%;object-fit:contain;align-self:flex-end;filter:drop-shadow(0 0 14px #000)}.p68UltBanner>i{font-size:45px;font-style:normal}.p68UltBanner small,.p68UltBanner b,.p68UltBanner span{display:block}.p68UltBanner small{font-size:5px;letter-spacing:.25em;color:#c6a766}.p68UltBanner b{margin:2px 0;color:#fff0bc;font:900 clamp(15px,2.3vw,28px) Georgia,serif}.p68UltBanner span{font-size:6px;color:#a8b2c1}\n.battleResult{background:radial-gradient(circle at 50% 45%,rgba(92,60,134,.26),transparent 36%),#03050bd9;backdrop-filter:blur(6px)}.resultCard.p68Result{position:relative;width:min(620px,94vw);max-height:88dvh;overflow:auto;padding:15px 18px 14px;border-radius:18px;background:radial-gradient(circle at 50% -5%,rgba(242,193,91,.14),transparent 34%),linear-gradient(160deg,#171b2a,#090e18);border:1px solid #75613e;box-shadow:0 25px 70px #000d,inset 0 1px #ffffff12}.resultCard.p68Result.defeat{border-color:#693942;background:radial-gradient(circle at 50% -5%,rgba(201,65,83,.13),transparent 34%),linear-gradient(160deg,#20151b,#090d15)}.p68ResultIcon{font-size:46px!important;filter:drop-shadow(0 5px 12px #0009)}.p68Result h2{font:900 25px Georgia,serif!important;color:#f5d68c;margin:-2px 0 3px!important}.p68Result.defeat h2{color:#ef9eaa}.p68Result .muted{font-size:6px}.p68ResultKicker{margin:5px auto 7px;color:#9c8a67;font-size:5px;letter-spacing:.15em;font-weight:900}.p68ResultStats{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin:6px 0}.p68ResultStats span{padding:6px 4px;border:1px solid #344057;border-radius:8px;background:#0b121e}.p68ResultStats small,.p68ResultStats b{display:block}.p68ResultStats small{font-size:3.5px;color:#718097}.p68ResultStats b{margin-top:2px;font-size:6px;color:#e9d19a}.p68Result .rewardRow{margin:7px 0;gap:4px}.p68Result .rewardChip{padding:5px 6px;font-size:5px;border-radius:7px;background:#0a111c;border-color:#3b465b}.p68ResultButton{min-height:30px;padding:6px 14px!important;font-size:6px!important;border-radius:8px!important}.p68Result .btn.primary,.p68ResultButton{background:linear-gradient(135deg,#6d4a23,#b27b31)!important;border-color:#d4ae61!important;color:#fff1c3!important}\n@keyframes p68impact{0%{opacity:0;transform:translate(-50%,-50%) scale(.2)}35%{opacity:1}100%{opacity:0;transform:translate(-50%,-50%) scale(1.7)}}@keyframes p68act{0%,100%{filter:none}45%{filter:brightness(1.5);transform:translateY(-50%) scale(1.08)}}@keyframes p68ultact{0%,100%{filter:none}35%{filter:brightness(1.8) drop-shadow(0 0 14px #e2ba68);transform:translateY(-50%) scale(1.1)}}@keyframes p68hit{20%{transform:translate(-3px,-50%)}45%{transform:translate(3px,-50%)}70%{transform:translate(-2px,-50%)}}@keyframes p68crit{15%{filter:brightness(2)}25%{transform:translate(-6px,-50%) rotate(-1deg)}55%{transform:translate(5px,-50%) rotate(1deg)}}@keyframes p68block{35%{filter:brightness(1.6) drop-shadow(0 0 8px #74aaff)}}@keyframes p68dodge{40%{transform:translate(10px,-50%);opacity:.72}}@keyframes p68banner{0%{opacity:0;transform:translate(-50%,-50%) scaleX(.25)}18%{opacity:1;transform:translate(-50%,-50%) scaleX(1.03)}30%,72%{transform:translate(-50%,-50%) scaleX(1)}100%{opacity:0;transform:translate(-50%,-50%) scaleX(1.03)}}@keyframes p68ready{50%{filter:brightness(1.25);box-shadow:0 0 16px #e4b75f66}}@keyframes p68low{50%{filter:brightness(1.35)}}\n@media(max-width:930px){.p68Battle .battleTop{height:38px}.p68Battle .battleArena{height:calc(100dvh - 38px)}.p68Battle .battleTop .btn{height:27px;min-width:34px;padding:0 6px;font-size:5px}.p68Battle .battleTop .p68Title{font-size:7px;max-width:40%}.p68BattleHud{top:3px;height:30px;width:260px;grid-template-columns:60px 1fr 60px}.p68Battle .battleOrder{top:37px;max-width:37%;height:27px}.p68Unit{width:clamp(103px,17.8vw,150px)!important;grid-template-columns:34px 1fr;gap:4px;padding:4px!important}.p68Portrait{width:34px;height:40px}.p68UnitTop b{font-size:4.6px}.p68UnitTop span{font-size:3px}.p68BarRow{grid-template-columns:18px 1fr 23px;gap:2px;margin-top:2px}.p68Ult{height:14px;font-size:3.2px}.p68Status{height:8px}.p68Battle .battleLog{width:220px;height:42px;font-size:3.7px}.p68Metrics{width:185px;height:42px}.p68Battle .p57AngelBattle{width:245px}.p68UltBanner{height:76px}.p68Result h2{font-size:21px!important}}\n@media(max-height:430px){.p68Unit{width:clamp(98px,17vw,145px)!important;grid-template-columns:31px 1fr}.p68Portrait{width:31px;height:35px}.p68Status{height:7px}.p68Battle .battleLog,.p68Metrics{height:38px}.p68Battle .p57AngelBattle{height:38px;grid-template-columns:31px 1fr auto}.p68Battle .p57AngelBattle img{width:29px;height:29px}.p68UltBanner{height:66px}.p68ResultStats span{padding:4px 3px}}\n</style>\n"},{"start":131410,"end":131502,"text":"    \"block\": 0.22,    \"resistance\": 0.18,\n    \"initialEnergy\": 500,\n    \"maxEnergy\": 1000,\n"},{"start":134286,"end":134528,"text":"    \"ultimateId\": \"ferro_veu_ult\",\n    \"actionPattern\": [\n      \"basic\",\n      \"basic\",\n      \"skill\"\n    ],\n    \"starCosts\": [\n      10,\n      20,\n      40,\n      80,\n      120\n    ],\n    \"gachaEligible\": true,\n    \"awakeningCapable\": false,\n"},{"start":150906,"end":151114,"text":"    \"actionPattern\": [\n      \"basic\",\n      \"basic\",\n      \"skill\"\n    ],\n    \"starCosts\": [\n      10,\n      20,      40,\n      80,\n      120\n    ],\n    \"gachaEligible\": true,\n    \"awakeningCapable\": false,\n"},{"start":153678,"end":153885,"text":"    \"actionPattern\": [\n      \"basic\",\n      \"basic\",\n      \"skill\"\n    ],\n    \"starCosts\": [\n      10,\n      20,\n      40,\n      80,\n      120\n    ],\n    \"gachaEligible\": true,\n    \"awakeningCapable\": false,\n"},{"start":170733,"end":170997,"text":"    \"kind\": \"damage\",\n    \"damageType\": \"magic\",\n    \"ratio\": 0.9,\n    \"target\": \"randomN\",\n    \"energyGain\": 300,\n    \"effects\": [\n      {\n        \"type\": \"buff\",\n        \"id\": \"armor_break\",\n        \"target\": \"targets\",\n        \"chance\": 0.75\n      }\n    ]  },\n"},{"start":173826,"end":173996,"text":"    \"kind\": \"damage\",\n    \"damageType\": \"physical\",\n    \"ratio\": 0.9,\n    \"target\": \"weighted\",\n    \"energyGain\": 300,\n    \"effects\": []\n  },\n  \"patrulheiro_verde_ult\": {\n"},{"start":190934,"end":191021,"text":"    },    \"4\": {\n      \"playerXp\": 12,\n      \"heroXp\": 50,\n      \"levelRecovery\": 20,\n"},{"start":193696,"end":193722,"text":"      \"heroMax\": 26\n    },\n"},{"start":209431,"end":209564,"text":"    {\n      \"id\": \"bronze_weapon\",      \"name\": \"Arma Bronze\",\n      \"slot\": \"weapon\",\n      \"rarity\": \"R\",\n      \"stat\": \"attack\",\n"},{"start":212559,"end":212620,"text":"      \"maxEnhance\": 25,\n      \"set\": \"Celestial\"\n    },\n    {\n"},{"start":229310,"end":229420,"text":"      \"qualityEssence\": 5,\n      \"runeStone\": 8,\n      \"dropTable\": \"elite\"\n    },\n    \"elite\": true  },\n  {\n"},{"start":232251,"end":232360,"text":"      \"qualityEssence\": 2,\n      \"runeStone\": 2,\n      \"dropTable\": \"elite\"\n    },\n    \"elite\": true\n  },\n  {\n"},{"start":2118151,"end":2118152,"text":""},{"start":2135297,"end":2135324,"text":"}\nfunction phase5Rewards(){\n"},{"start":2140480,"end":2140533,"text":" const profile=window.NerdoraChibiBridge?.profile||null,name=profile?.publicName||profile?.username||'Nerdora Raider',photo=profile?.photoUrl||'',connected=!!window.NerdoraChibiBridge?.connected;\n const esc=v=>String(v??'').replace(/[&<>\\\"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\"'\":'&#39;'}[m]));\n const ownedCount=D.heroes.filter(h=>state.heroes[h.id]?.owned).length,teamCount=team.length;\n $('#screen').innerHTML=`<section class=\"cityScene cityRemaster\">\n"},{"start":2140606,"end":2141577,"text":"   <i class=\"cityShade\"></i><i class=\"cityAurora\"></i><i class=\"cityVignette\"></i>\n   <header class=\"cityTopHud\">\n     <button class=\"cityProfile cityGlass\" onclick=\"phase5Vip()\">\n       <span class=\"cityAvatarFrame\"><span class=\"cityAvatarInner\">${photo?`<img src=\"${esc(photo)}\" alt=\"${esc(name)}\">`:(name.trim()[0]||'N').toUpperCase()}</span></span>\n       <span class=\"cityLevelOrb\">${p.level}</span>\n       <span class=\"cityProfileCopy\"><small>RAIDER</small><span class=\"cityProfileName\">${esc(name)}</span><span class=\"cityVip\">VIP ${p.vip}</span></span>\n     </button>\n     <div class=\"cityResources cityGlass\">\n       <button class=\"cityResource\" onclick=\"Game.openShop()\"><span class=\"resIcon gold\">●</span><span class=\"resCopy\"><small>OURO</small><b id=\"cityGold\">${fmt(p.gold)}</b></span><span class=\"plus\">+</span></button>\n       <button class=\"cityResource\" onclick=\"Game.openShop()\"><span class=\"resIcon gems\">◆</span><span class=\"resCopy\"><small>GEMAS</small><b id=\"cityGems\">${fmt(p.gems)}</b></span><span class=\"plus\">+</span></button>\n       <button class=\"cityResource\" onclick=\"UI.nav('missions')\"><span class=\"resIcon energy\">◐</span><span class=\"resCopy\"><small>ENERGIA</small><b id=\"cityEnergy\">${p.energy}/${p.maxEnergy}</b></span><span class=\"plus\">+</span></button>\n"},{"start":2141589,"end":2141683,"text":"     <div class=\"cityTopMeta cityGlass\"><span class=\"cityOnlineDot ${connected?'online':'local'}\"></span><div><small>${connected?'NERDORA ONLINE':'MODO LOCAL'}</small><b class=\"cityClock\">${date} · ${clock}</b></div><button onclick=\"UI.nav('settings')\" aria-label=\"Configurações\">⚙</button></div>\n   </header>\n\n   <div class=\"cityEventRow cityGlass\">\n"},{"start":2141934,"end":2141974,"text":"   </div>\n\n   <aside class=\"cityLeftMenu cityRail cityRailDaily\">\n     <div class=\"cityRailTitle\"><small>ROTINA</small><b>Hoje</b></div>\n"},{"start":2142258,"end":2142299,"text":"   </aside>\n\n   <aside class=\"cityRightMenu cityRail cityRailManage\">\n     <div class=\"cityRailTitle\"><small>EQUIPE</small><b>Gestão</b></div>\n"},{"start":2142578,"end":2142588,"text":"   </aside>\n\n   <div class=\"cityTeamHalo\" aria-hidden=\"true\"></div>\n"},{"start":2142681,"end":2142790,"text":"   <button class=\"cityTeamPlate cityGlass\" onclick=\"UI.nav('formation')\">\n      <span class=\"cityTeamIcon\">⚔</span><span><small>FORMAÇÃO ATIVA</small><b>${fmt(teamPower())}</b><em>${teamCount}/5 heróis · ${ownedCount}/${D.heroes.length} obtidos</em></span><i>›</i>\n   </button>\n\n   <nav class=\"cityBottomDock cityGlass\" aria-label=\"Ações principais\">\n"},{"start":2143418,"end":2143497,"text":"   </nav>\n   <div class=\"cityVersion\">v10.3.0</div>\n"},{"start":2363424,"end":2363425,"text":""},{"start":2400080,"end":2400995,"text":"function p541Owners(itemId){const out=[];for(const b of D.heroes){const h=heroState(b.id);for(const [slot,e] of Object.entries(h?.equipment||{}))if(e?.id===itemId)out.push(`${b.name} · ${P541_SLOT_NAME[slot]}`)}return out}\nfunction p541SetPanel(id){const counts=p541SetCounts(id),recommended=p541RecommendedSet(id);return `<div class=\"p541SetPanel\">${Object.entries(P541_SETS).map(([name,d])=>{const c=counts[name]||0;return `<div class=\"p541SetCard ${c>=2?'active':''}\" style=\"--set:${d.color}\"><div class=\"p541SetHead\"><b>${d.icon} ${name}</b><strong>${c}/6</strong></div><div class=\"p541SetDesc\">${d.role}<br>${d.desc}</div><div class=\"p541SetTiers\">${[2,4,6].map(n=>`<div class=\"p541SetTier ${c>=n?'on':''}\">${c>=n?'✓':'○'} ${n} peças · ${p541BonusText(d.tiers[n])}</div>`).join('')}</div>${recommended===name?'<div class=\"p541Recommended\">★ Recomendado para a função atual</div>':''}</div>`}).join('')}</div>`}\n"},{"start":3304675,"end":3304777,"text":"// ============================================================\nstate.version='10.2.0-phase6.ui.2';\n"},{"start":3317070,"end":3317134,"text":"});const p602CopyDefenseBase=Game.copyArenaDefense.bind(Game);\n"},{"start":3321318,"end":3321339,"text":"\n// ============================================================\n// FASE 6.UI.3 · HERÓIS + EVOLUÇÃO + FORMAÇÃO + ANGELS\n// ============================================================\nstate.version='10.3.0-phase6.ui.3';\n\nconst P63={formationCandidate:null,formationSlot:null};\nwindow.P63=P63;\n\n// --- HERÓIS: vitrine fixa + atalhos de desenvolvimento ---\nheroFocusHtml=function(h){\n const hs=heroState(h.id),owned=!!hs?.owned,src=PHASE5_HERO_ASSETS?.[h.id],k=typeof p525Kit==='function'?p525Kit(h.id):null;\n if(!owned){return `<div class=\"heroFocusPanel p63HeroFocus locked\"><i class=\"heroFocusGlow\"></i><div class=\"heroFocusArt\">${src?`<img style=\"filter:grayscale(1) brightness(.34)\" src=\"${src}\" alt=\"\">`:`<span class=\"heroFocusEmoji\">❔</span>`}<span class=\"heroFocusLocked\">🔒</span></div><div class=\"heroFocusInfo\"><div class=\"heroFocusTop\"><div class=\"heroFocusName\"><small class=\"p63Kicker\">HERÓI NÃO RECRUTADO</small><h2>${h.name}</h2><div class=\"heroFocusSub\">${h.rarity} · ${h.heroClass||h.role}</div></div><span class=\"heroFocusRarity\">${h.rarity}</span></div><div class=\"p63LockedHint\">Encontre este herói no Portal para liberar ficha, evolução, equipamentos e Crônicas.</div><div class=\"heroFocusActions\"><button class=\"focusBtn\" onclick=\"UI.nav('lobby')\">Cidade</button><button class=\"focusBtn primary\" onclick=\"UI.nav('gacha')\">🌀 Ir ao Portal</button></div></div></div>`}\n const s=heroStats(h.id),power=heroPower(h.id),atk=Math.max(s.patk,s.matk),stars=Math.max(0,Math.min(6,hs.stars||0));\n return `<div class=\"heroFocusPanel p63HeroFocus\" data-rarity=\"${h.rarity}\" style=\"--p63-accent:${k?.color||'#9d72ff'}\"><i class=\"heroFocusGlow\"></i><div class=\"p63HeroAura\"></div><div class=\"heroFocusArt\">${src?`<img src=\"${src}\" alt=\"${h.name}\">`:`<span class=\"heroFocusEmoji\">${h.emoji}</span>`}</div><div class=\"heroFocusInfo\">\n  <div class=\"heroFocusTop\"><div class=\"heroFocusName\"><small class=\"p63Kicker\">${k?.faction||'NERDORA'} · ${k?.element||h.role}</small><h2>${h.name}</h2><div class=\"heroFocusSub\">${k?.tactical||h.heroClass||h.role} · Lv.${hs.level}</div></div><span class=\"heroFocusRarity\">${h.rarity}</span></div>\n  <div class=\"p63HeroMetricRow\"><span class=\"heroFocusPower\">⚔ ${fmt(power)}</span><span class=\"heroFocusStars\">${'★'.repeat(stars)}${'☆'.repeat(6-stars)}</span><span class=\"p63Quality\">${QN[hs.quality]||hs.quality}</span></div>\n  <div class=\"focusStats\"><div class=\"focusStat\"><b>${fmt(s.hp)}</b><span>HP</span></div><div class=\"focusStat\"><b>${fmt(atk)}</b><span>${h.basicType==='physical'?'ATQ':'MAG'}</span></div><div class=\"focusStat\"><b>${fmt(s.pdef)}</b><span>DEF</span></div><div class=\"focusStat\"><b>${fmt(s.agility)}</b><span>AGI</span></div></div>\n  <div class=\"p63HeroCommands\"><button onclick=\"UI.openHero('${h.id}','upgrade')\"><i>⬆</i><span><b>Evoluir</b><small>Nível · Estrelas · Ruptura</small></span></button><button onclick=\"UI.openHero('${h.id}','gear')\"><i>⚔</i><span><b>Build</b><small>Equipamentos · Runas · Emblemas</small></span></button><button onclick=\"UI.openHero('${h.id}','ascension')\"><i>☀</i><span><b>Ascensão</b><small>Renascimento · Constelação · Divindade</small></span></button></div>\n  <div class=\"heroFocusActions\"><button class=\"focusBtn\" onclick=\"UI.nav('formation')\">🛡 Formação</button><button class=\"focusBtn primary\" onclick=\"UI.openHero('${h.id}','overview')\">Abrir ficha completa</button></div>\n </div></div>`;\n};\n\nrenderHeroes=function(){\n const rarityOrder=['C','R','EP','SR','SSR'],available=rarityOrder.filter(r=>D.heroes.some(h=>h.rarity===r)),filters=['all',...available];\n const list=D.heroes.filter(h=>(UI.heroFilter==='all'||h.rarity===UI.heroFilter)&&(UI.heroOwned==='all'||(UI.heroOwned==='owned'?state.heroes[h.id].owned:!state.heroes[h.id].owned)));\n const ownedCount=D.heroes.filter(h=>state.heroes[h.id]?.owned).length,starsTotal=D.heroes.reduce((n,h)=>n+(state.heroes[h.id]?.owned?(state.heroes[h.id].stars||0):0),0);\n let selected=list.find(h=>h.id===UI.selectedHero);if(!selected)selected=list.find(h=>state.heroes[h.id]?.owned)||list[0]||D.heroes.find(h=>state.heroes[h.id]?.owned)||D.heroes[0];if(selected)UI.selectedHero=selected.id;\n $('#screen').innerHTML=`<section class=\"heroesStage p63HeroesStage\"><header class=\"heroesHeader\"><button class=\"heroesBack\" onclick=\"UI.nav('lobby')\">‹</button><div class=\"heroesHeading\"><small class=\"p63Kicker\">SALÃO DE HERÓIS</small><h1>Heróis</h1><p>Coleção e desenvolvimento da sua equipe</p></div><div class=\"heroesHeaderStats\"><span class=\"heroSortBadge\">Coleção <b>${ownedCount}/${D.heroes.length}</b></span><span class=\"heroCountBadge\">★ ${starsTotal} estrelas</span></div></header><div class=\"heroesToolbar\"><div class=\"rosterTabs\">${filters.map(f=>`<button class=\"rosterChip rarity-${f} ${UI.heroFilter===f?'active':''}\" onclick=\"UI.setHeroFilter('${f}')\">${f==='all'?'Todos':f}</button>`).join('')}</div><but